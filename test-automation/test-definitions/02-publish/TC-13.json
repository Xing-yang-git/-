{
  "id": "TC-13",
  "cat": "02-publish",
  "title": "发布——标题100字边界",
  "tags": [
    "publish",
    "validation"
  ],
  "steps": [
    {
      "action": "navigate",
      "url": "/pages/publish-idle/publish-idle?type=LEND",
      "method": "navigateTo"
    },
    {
      "action": "wait",
      "condition": "1500"
    },
    {
      "action": "evaluate",
      "code": "var title='';for(var i=0;i<100;i++)title+='测';var pages=getCurrentPages();pages[pages.length-1].setData({title:title});return title.length"
    },
    {
      "action": "wait",
      "condition": "500"
    }
  ],
  "assertions": [
    {
      "type": "data",
      "path": "title.length",
      "equals": "100"
    }
  ]
}