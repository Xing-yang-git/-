{
  "id": "TC-12",
  "cat": "02-publish",
  "title": "发布——价格校验边界值（超限阻断）",
  "tags": [
    "publish",
    "validation"
  ],
  "steps": [
    {
      "action": "navigate",
      "url": "/pages/publish-idle/publish-idle?type=LEND",
      "method": "navigateTo"
    },
    {
      "action": "wait",
      "condition": "1500"
    },
    {
      "action": "input",
      "selector": "input[placeholder*='标题']",
      "value": "测试物品"
    },
    {
      "action": "tap",
      "selector": ".pill:nth-child(1)"
    },
    {
      "action": "wait",
      "condition": "300"
    },
    {
      "action": "input",
      "selector": "input[type=digit]",
      "value": "100000000"
    },
    {
      "action": "input",
      "selector": ".textarea",
      "value": "测试"
    },
    {
      "action": "wait",
      "condition": "300"
    },
    {
      "action": "tap",
      "selector": ".btn-primary.btn-block"
    },
    {
      "action": "wait",
      "condition": "2000"
    }
  ],
  "assertions": [
    {
      "type": "visible",
      "selector": ".btn-primary.btn-block"
    }
  ]
}