{
  "id": "TC-LOGIN-07",
  "cat": "01-registration-login",
  "title": "登录页离开时清空密码",
  "tags": [
    "login",
    "security"
  ],
  "steps": [
    {
      "action": "navigate",
      "url": "/pages/login/login",
      "method": "reLaunch"
    },
    {
      "action": "wait",
      "condition": "1500"
    },
    {
      "action": "input",
      "selector": ".phone-input input",
      "value": "13800000001"
    },
    {
      "action": "input",
      "selector": ".password-input input",
      "value": "pass1234"
    },
    {
      "action": "wait",
      "condition": "300"
    },
    {
      "action": "tap",
      "selector": ".switch-login"
    },
    {
      "action": "wait",
      "condition": "1000"
    },
    {
      "action": "navigate",
      "url": "",
      "method": "navigateBack"
    },
    {
      "action": "wait",
      "condition": "1000"
    }
  ],
  "assertions": [
    {
      "type": "page",
      "contains": "login"
    }
  ]
}