{
  "id": "TC-REG-04",
  "cat": "01-registration-login",
  "title": "注册——昵称预览实时更新",
  "tags": [
    "registration",
    "ui"
  ],
  "steps": [
    {
      "action": "navigate",
      "url": "/pages/register/register",
      "method": "navigateTo"
    },
    {
      "action": "wait",
      "condition": "1500"
    },
    {
      "action": "tap",
      "selector": ".list-row:first-child"
    },
    {
      "action": "wait",
      "condition": "300"
    },
    {
      "action": "tap",
      "selector": ".btn-primary"
    },
    {
      "action": "wait",
      "condition": "500"
    },
    {
      "action": "input",
      "selector": "input[placeholder*='栋']",
      "value": "5"
    },
    {
      "action": "input",
      "selector": "input[placeholder*='单元']",
      "value": "3"
    },
    {
      "action": "input",
      "selector": "input[placeholder*='房']",
      "value": "2801"
    },
    {
      "action": "tap",
      "selector": ".segment-item[data-type='tenant']"
    },
    {
      "action": "wait",
      "condition": "500"
    }
  ],
  "assertions": [
    {
      "type": "data",
      "path": "nickPreview",
      "contains": "2801"
    }
  ]
}