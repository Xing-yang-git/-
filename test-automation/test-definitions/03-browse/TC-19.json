{
  "id": "TC-19",
  "cat": "03-browse",
  "title": "首页三 Tab 切换",
  "tags": [
    "smoke",
    "home"
  ],
  "steps": [
    {
      "action": "navigate",
      "url": "/pages/home/home",
      "method": "switchTab"
    },
    {
      "action": "wait",
      "condition": "2000"
    },
    {
      "action": "tap",
      "selector": ".segment-item[data-tab=\"2\"]"
    },
    {
      "action": "wait",
      "condition": "1000"
    },
    {
      "action": "tap",
      "selector": ".segment-item[data-tab=\"1\"]"
    },
    {
      "action": "wait",
      "condition": "1000"
    },
    {
      "action": "tap",
      "selector": ".segment-item[data-tab=\"0\"]"
    },
    {
      "action": "wait",
      "condition": "1000"
    }
  ],
  "assertions": [
    {
      "type": "data",
      "path": "currentTab",
      "equals": 0
    }
  ]
}