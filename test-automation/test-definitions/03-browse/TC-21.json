    },
    {
      "action": "input",
      "selector": ".search-input",
      "value": "'; DROP TABLE users; --"
    },
    {
      "action": "wait",
      "condition": "2000"
    }
  ],
  "assertions": [
    {
      "type": "visible",
      "selector": ".empty-state"
    }
  ]
}