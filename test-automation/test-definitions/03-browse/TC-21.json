{
  "id": "TC-21",
  "cat": "03-browse",
  "title": "搜索——特殊字符和 SQL 注入安全",
  "tags": [
    "search",
    "security"
  ],
  "steps": [
    {
      "action": "navigate",
      "url": "/pages/search/search",
      "method": "navigateTo"
    },
    {
      "action": "wait",
