.container {
  padding: 16px;
  padding-bottom: 80px;
  background: var(--bg);
  min-height: 100vh;
}

/* 摘要行 */
.summary-row {
  display: flex;
  align-items: center;
  gap: 12px;
}

.item-img {
  width: 60px;
  height: 60px;
  border-radius: 8px;
}

.item-placeholder {
  width: 60px;
  height: 60px;
  border-radius: 8px;
  background: var(--fill-quaternary);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 28px;
}

.item-info {
  display: flex;
  flex-direction: column;
  gap: 4px;
}

.item-title {
  font-size: 15px;
  color: var(--text);
  font-weight: 500;
}

.borrower-name {
  font-size: 13px;
  color: var(--text-tertiary);
}

/* 切换行 */
.toggle-row {
  display: flex;
  gap: 12px;
}

.toggle-item {
  flex: 1;
  text-align: center;
  padding: 10px 0;
  border: 1px solid var(--separator);
  border-radius: 8px;
  font-size: 15px;
  color: var(--text-secondary);
}

.toggle-item.active {
  color: var(--surface);
  border-color: transparent;
}

.toggle-item.active.positive {
  background: var(--green);
}

.toggle-item.active.negative {
  background: var(--red);
}

/* 状态卡片 */
.status-cards {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 10px;
}

.status-card {
  text-align: center;
  padding: 16px 8px;
  border: 2px solid var(--separator);
  border-radius: 12px;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 6px;
}

.status-card.selected {
  border-color: transparent;
}

.status-card.selected.green {
  background: #e8f8e8;
  border-color: var(--green);
}

.status-card.selected.yellow {
  background: #fff8e8;
  border-color: var(--orange);
}

.status-card.selected.red {
  background: #ffe8e8;
  border-color: var(--red);
}

.status-icon {
  font-size: 24px;
}

.status-label {
  font-size: 13px;
  color: var(--text);
}

/* 损坏选项 */
.damage-options {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 10px;
}

.damage-item {
  text-align: center;
  padding: 12px 4px;
  border: 2px solid var(--separator);
  border-radius: 8px;
  font-size: 13px;
  color: var(--text-secondary);
}

.damage-item.selected.green-bg {
  background: #e8f8e8;
  border-color: var(--green);
  color: var(--green);
}

.damage-item.selected.yellow-bg {
  background: #fff8e8;
  border-color: var(--orange);
  color: var(--orange);
}

.damage-item.selected.red-bg {
  background: #ffe8e8;
  border-color: var(--red);
  color: var(--red);
}

.add-icon {
  font-size: 36px;
  color: var(--text-quaternary);
}

