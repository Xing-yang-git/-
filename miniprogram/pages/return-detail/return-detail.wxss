.container {
  padding: 32rpx;
  padding-bottom: 160rpx;
  background: var(--bg);
  min-height: 100vh;
}

/* 摘要行 */
.summary-row {
  display: flex;
  align-items: center;
  gap: 24rpx;
}

.item-img {
  width: 120rpx;
  height: 120rpx;
  border-radius: 16rpx;
}

.item-placeholder {
  width: 120rpx;
  height: 120rpx;
  border-radius: 16rpx;
  background: var(--fill-quaternary);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 56rpx;
}

.item-info {
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}

.item-title {
  font-size: 30rpx;
  color: var(--text);
  font-weight: 500;
}

.borrower-name {
  font-size: 26rpx;
  color: var(--text-tertiary);
}

/* 切换行 */
.toggle-row {
  display: flex;
  gap: 24rpx;
}

.toggle-item {
  flex: 1;
  text-align: center;
  padding: 20rpx 0;
  border: 2rpx solid var(--separator);
  border-radius: 16rpx;
  font-size: 30rpx;
  color: var(--text-secondary);
}

.toggle-item.active {
  color: var(--surface);
  border-color: transparent;
}

.toggle-item.active.positive {
  background: var(--green);
}

.toggle-item.active.negative {
  background: var(--red);
}

/* 状态卡片 */
.status-cards {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 20rpx;
}

.status-card {
  text-align: center;
  padding: 32rpx 16rpx;
  border: 4rpx solid var(--separator);
  border-radius: 24rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 12rpx;
}

.status-card.selected {
  border-color: transparent;
}

.status-card.selected.green {
  background: var(--green-bg);
  border-color: var(--green);
}

.status-card.selected.yellow {
  background: var(--orange-bg);
  border-color: var(--orange);
}

.status-card.selected.red {
  background: var(--red-bg);
  border-color: var(--red);
}

.status-icon {
  font-size: 48rpx;
}

.status-label {
  font-size: 26rpx;
  color: var(--text);
}

/* 损坏选项 */
.damage-options {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 20rpx;
}

.damage-item {
  text-align: center;
  padding: 24rpx 8rpx;
  border: 4rpx solid var(--separator);
  border-radius: 16rpx;
  font-size: 26rpx;
  color: var(--text-secondary);
}

.damage-item.selected.green-bg {
  background: var(--green-bg);
  border-color: var(--green);
  color: var(--green);
}

.damage-item.selected.yellow-bg {
  background: var(--orange-bg);
  border-color: var(--orange);
  color: var(--orange);
}

.damage-item.selected.red-bg {
  background: var(--red-bg);
  border-color: var(--red);
  color: var(--red);
}

.add-icon {
  font-size: 72rpx;
  color: var(--text-quaternary);
}

