.container {
  display: flex;
  flex-direction: column;
  height: 100vh;
  background: var(--bg);
}

/* Top Bar */
.top-bar {
  background: var(--surface);
  padding: 12px 16px;
  border-bottom: 1px solid var(--separator);
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.top-name {
  font-size: 16px;
  font-weight: 600;
  color: var(--text);
}

.top-room {
  font-size: 12px;
  color: var(--text-tertiary);
}

.top-about {
  font-size: 13px;
  color: var(--blue);
  padding: 4px 10px;
  background: #e8f4fd;
  border-radius: 12px;
}

/* Message List */
.msg-list {
  flex: 1;
  padding: 12px 16px;
}

/* Time Divider */
.time-divider {
  text-align: center;
  margin: 16px 0;
}

.time-divider text {
  font-size: 12px;
  color: var(--text-tertiary);
  background: var(--bg);
  padding: 4px 12px;
  border-radius: 10px;
}

/* Message Row */
.msg-row {
  display: flex;
  margin-bottom: 16px;
  align-items: flex-start;
}

.msg-left {
  justify-content: flex-start;
}

.msg-right {
  justify-content: flex-end;
}

.my-avatar {
  background: var(--blue);
  margin-left: 8px;
}

.other-avatar {
  background: var(--green);
  margin-right: 8px;
}

/* Bubbles */
.bubble {
  max-width: 65%;
  padding: 10px 14px;
  border-radius: 16px;
  font-size: 15px;
  line-height: 1.5;
  word-break: break-all;
}

.bubble-other {
  background: var(--surface);
  color: var(--text);
  border: 1px solid var(--separator);
  border-top-left-radius: 4px;
}

.bubble-mine {
  background: var(--blue);
  color: var(--surface);
  border-top-right-radius: 4px;
}

/* Quick Templates */
.templates {
  display: flex;
  gap: 8px;
  padding: 8px 16px;
  background: var(--surface);
  border-top: 1px solid var(--separator-opaque);
  overflow-x: auto;
  white-space: nowrap;
}

.template-chip {
  flex-shrink: 0;
  padding: 6px 14px;
  background: var(--fill-quaternary);
  border-radius: 16px;
  font-size: 13px;
  color: var(--text-secondary);
}

.template-chip:active {
  background: var(--blue);
  color: var(--surface);
}

/* Input Bar */
.input-bar {
  display: flex;
  align-items: center;
  padding: 8px 12px;
  padding-bottom: calc(8px + env(safe-area-inset-bottom));
  background: var(--surface);
  border-top: 1px solid var(--separator);
  gap: 8px;
}

.msg-input {
  flex: 1;
  height: 40px;
  background: var(--bg);
  border-radius: 20px;
  padding: 0 16px;
  font-size: 14px;
}

.send-btn {
  width: 64px;
  height: 40px;
  background: var(--blue);
  color: var(--surface);
  font-size: 14px;
  border-radius: 20px;
  border: none;
  line-height: 40px;
  padding: 0;
}
