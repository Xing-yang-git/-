/* ===== 聊天页 — 对齐设计原型 chat.html + ios-ui.css ===== */
/* 设计稿 375px → 小程序 750rpx（1px = 2rpx） */

.chat-page {
  display: flex;
  flex-direction: column;
  height: 100vh;
  background: var(--bg, var(--fill-tertiary));
}

/* ===== 自定义导航栏 ===== */
.chat-nav {
  background: rgba(255, 255, 255, 0.94);
  flex-shrink: 0;
  z-index: 100;
}

.chat-nav-inner {
  display: flex;
  align-items: center;
  height: 88rpx; /* 44px → 88rpx */
  padding: 0 32rpx; /* 16px → 32rpx */
  position: relative;
}

/* 返回按钮 — 绝对定位左侧，与原型 .nav-back 一致 */
.chat-nav-back {
  position: absolute;
  left: 26rpx; /* 13px → 26rpx */
  display: flex;
  align-items: center;
  padding: 16rpx 16rpx 16rpx 0;
  min-height: 88rpx; /* 44px → 88rpx */
  z-index: 1;
}

.chat-nav-back-icon {
  font-size: 56rpx; /* 28px → 56rpx */
  line-height: 1;
  font-weight: 400;
  color: var(--text-secondary, var(--text-tertiary));
}

/* 标题 — 紧跟返回按钮后方，左对齐 */
.chat-nav-title {
  font-size: 34rpx; /* 17px → 34rpx */
  font-weight: 600;
  color: var(--text, var(--text));
  letter-spacing: -0.01em;
  margin-left: 56rpx; /* 返回按钮宽度 + 间距，使标题紧靠返回按钮右侧 */
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  max-width: 70%;
}

.chat-area {
  flex: 1;
  padding: 32rpx; /* 16px → 32rpx */
  overflow-y: auto;
}

/* 时间分割线 — 原型：无胶囊底色，居中纯文字 */
.chat-time-divider {
  text-align: center;
  font-size: 24rpx; /* 12px → 24rpx */
  color: var(--text-tertiary);
  padding: 16rpx 0; /* 8px → 16rpx */
}

/* ----- 气泡基础 ----- */
.chat-bubble {
  max-width: 75%;
  padding: 20rpx 28rpx; /* 10px 14px → 20rpx 28rpx */
  border-radius: 18rpx;
  font-size: 34rpx; /* 17px → 34rpx */
  line-height: 1.4;
  word-break: break-all;
}

/* 左气泡（对方） — 灰底 */
.chat-bubble-left {
  background: rgba(120, 120, 128, 0.12);
  color: var(--text, var(--text));
}

/* 右气泡（我方） — 蓝底白字 */
.chat-bubble-right {
  margin-left: auto;
  background: var(--blue, var(--blue));
  color: var(--surface);
}

/* 系统消息 — 居中灰胶囊 + 图标 */
.chat-bubble-system {
  text-align: center;
  font-size: 24rpx; /* 12px → 24rpx */
  color: var(--text-secondary);
  background: rgba(120, 120, 128, 0.08);
  padding: 12rpx 24rpx; /* 6px 12px → 12rpx 24rpx */
  border-radius: 24rpx; /* 12px → 24rpx */
  margin-bottom: 24rpx;
  display: inline-block;
  align-self: center;
  max-width: 90%;
}

.system-icon {
  font-size: 32rpx; /* 16px → 32rpx */
  margin-right: 8rpx;
}

/* ----- 加载提示 ----- */
.chat-loading-tip {
  text-align: center;
  font-size: 24rpx;
  color: var(--text-tertiary);
  padding: 16rpx 0;
}

/* ----- 消息行（我方） — 包含状态文字 + 气泡 ----- */
.chat-msg-row {
  display: flex;
  align-items: flex-end;
  justify-content: flex-end;
  margin-bottom: 24rpx;
}

/* 左气泡行 — 独立类名避免与 .chat-msg-row 的 justify-content:flex-end 冲突 */
.chat-msg-row-left {
  display: flex;
  align-items: flex-end;
  justify-content: flex-start;
  margin-bottom: 24rpx;
}

/* ----- 发送状态文字 ----- */
.chat-status-text {
  font-size: 22rpx;
  color: var(--text-tertiary);
  margin-right: 8rpx;
  flex-shrink: 0;
}

/* ----- 重发按钮 ----- */
.chat-retry-btn {
  width: 40rpx;
  height: 40rpx;
  border-radius: 50%;
  background: var(--red, var(--red));
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: 8rpx;
  flex-shrink: 0;
}

.retry-icon {
  color: var(--surface);
  font-size: 24rpx;
  font-weight: 700;
}

/* ===== 语音气泡 ===== */
.chat-bubble-voice {
  display: flex;
  align-items: center;
  gap: 8rpx;
  min-width: 150rpx;
  max-width: 60%;
  cursor: pointer;
}

.voice-unread-dot {
  width: 14rpx;
  height: 14rpx;
  border-radius: 50%;
  background: var(--red);
  flex-shrink: 0;
  margin-left: 10rpx;                  /* 5px 间距，红点在气泡右侧外部 */
  align-self: center;                   /* 垂直居中于气泡侧边 */
}

.voice-play-icon {
  width: 36rpx;
  height: 36rpx;
  flex-shrink: 0;
}

.voice-waveform {
  display: flex;
  align-items: flex-end;
  gap: 3rpx;
  height: 28rpx;
  flex: 1;
  min-width: 36rpx;
}
.voice-waveform .v-wave-bar {
  width: 4rpx;
  border-radius: 2rpx;
  flex-shrink: 0;
}
.chat-bubble-left .voice-waveform .v-wave-bar { background: var(--text); }
.chat-bubble-right .voice-waveform .v-wave-bar { background: var(--surface); }
.voice-waveform .v-wave-bar:nth-child(1) { height: 14rpx; }
.voice-waveform .v-wave-bar:nth-child(2) { height: 24rpx; }
.voice-waveform .v-wave-bar:nth-child(3) { height: 16rpx; }

.voice-bar-anim {
  animation: voicePlayBar 0.5s ease-in-out infinite alternate;
}
.voice-duration {
  font-size: 26rpx;
  flex-shrink: 0;
}

/* ===== 图片气泡 ===== */
.chat-bubble-image {
  padding: 6rpx;
  overflow: hidden;
  max-width: 65%;
  background: transparent !important;
}

.msg-image-thumb {
  max-width: 360rpx;
  max-height: 360rpx;
  min-width: 80rpx;
  min-height: 80rpx;
  border-radius: 14rpx;
  display: block;
}

/* ===== 悬浮操作菜单 ===== */
.msg-menu-overlay {
  position: fixed;
  left: 0; top: 0; right: 0; bottom: 0;
  z-index: 200;
  background: transparent;
}
.msg-menu-popup {
  position: absolute;
  background: var(--surface);
  border-radius: 16rpx;
  box-shadow: 0 4rpx 24rpx rgba(0, 0, 0, 0.15);
  display: flex;
  flex-direction: row;
  overflow: hidden;
}
.msg-menu-item {
  padding: 18rpx 28rpx;
  font-size: 26rpx;
  color: var(--text, var(--text));
  text-align: center;
  white-space: nowrap;
  position: relative;
}
.msg-menu-item:active {
  background: rgba(120, 120, 128, 0.12);
}
.msg-menu-item + .msg-menu-item {
  border-left: 0.5px solid rgba(120, 120, 128, 0.15);
}
