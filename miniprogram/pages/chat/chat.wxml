<!-- 聊天页 — 语音 + 图片 + 文字消息 -->
<view class="chat-page">

  <!-- 自定义导航栏 -->
  <view class="chat-nav" style="padding-top: {{statusBarHeight}}px;">
    <view class="chat-nav-inner">
      <view class="chat-nav-back" bindtap="onNavBack">
        <text class="chat-nav-back-icon">‹</text>
      </view>
      <text class="chat-nav-title">{{otherName || '聊天'}}</text>
    </view>
  </view>

  <!-- 聊天消息区 -->
  <scroll-view class="chat-area" scroll-y scroll-into-view="{{scrollToView}}" scroll-with-animation enhanced show-scrollbar="{{false}}"
               style="padding-bottom: {{chatPaddingBottom}}px;"
               bindscrolltoupper="onScrollToUpper" upper-threshold="80"
               bindscroll="onMsgMenuDismiss"
               bindtap="onChatAreaTap">

    <view class="chat-loading-tip" wx:if="{{loadingOlder}}">加载中...</view>
    <view class="chat-loading-tip" wx:elif="{{!hasMore && messages.length > 0}}">没有更多消息了</view>

    <block wx:for="{{messages}}" wx:key="id">

      <!-- 时间分割线 -->
      <view class="chat-time-divider" wx:if="{{item.showTime}}">{{item.timeText}}</view>

      <!-- 系统消息 -->
      <view class="chat-bubble-system" wx:if="{{item.type === 'system'}}">
        <text class="system-icon" wx:if="{{item.systemIcon}}">{{item.systemIcon}}</text>
        {{item.content}}
      </view>

      <!-- 撤回提示 -->
      <view class="chat-time-divider" wx:if="{{item.recalled && !item.isMine}}">对方撤回了一条消息</view>
      <view class="chat-time-divider" wx:if="{{item.recalled && item.isMine}}">你撤回了一条消息</view>

      <!-- ===== 语音消息（未撤回，非系统） ===== -->
      <block wx:if="{{item.type === 'voice' && !item.recalled}}">
        <!-- 对方语音（左） -->
        <view class="chat-msg-row-left" wx:if="{{!item.isMine}}">
          <view class="chat-bubble chat-bubble-left chat-bubble-voice" id="msg-bubble-{{index}}" bindtap="onPlayVoice" bindlongpress="onMsgLongPress" data-id="{{item.id}}" data-index="{{index}}" data-item="{{item}}">
            <image class="voice-play-icon" src="{{playingId === item.id ? '../../images/icon-pause.svg' : '../../images/icon-play.svg'}}" mode="aspectFit"></image>
            <view class="voice-waveform">
              <view class="v-wave-bar {{playingId === item.id ? 'voice-bar-anim' : ''}}" style="animation-delay:0s"></view>
              <view class="v-wave-bar {{playingId === item.id ? 'voice-bar-anim' : ''}}" style="animation-delay:0.15s"></view>
              <view class="v-wave-bar {{playingId === item.id ? 'voice-bar-anim' : ''}}" style="animation-delay:0.3s"></view>
            </view>
            <text class="voice-duration">{{item.voiceDuration}}″</text>
          </view>
          <view class="voice-unread-dot" wx:if="{{!item.voicePlayed}}"></view>
        </view>
        <!-- 我的语音（右） -->
        <view class="chat-msg-row" wx:if="{{item.isMine}}">
          <view class="chat-retry-btn" wx:if="{{item.sendFailed}}" bindtap="onRetrySend" data-id="{{item.id}}">
            <text class="retry-icon">!</text>
          </view>
          <text class="chat-status-text" wx:elif="{{item.status === 'sending'}}">发送中</text>
          <view class="chat-bubble chat-bubble-right chat-bubble-voice" id="msg-bubble-{{index}}" bindtap="onPlayVoice" bindlongpress="onMsgLongPress" data-id="{{item.id}}" data-index="{{index}}" data-item="{{item}}">
            <text class="voice-duration">{{item.voiceDuration}}″</text>
            <view class="voice-waveform">
              <view class="v-wave-bar {{playingId === item.id ? 'voice-bar-anim' : ''}}" style="animation-delay:0s"></view>
              <view class="v-wave-bar {{playingId === item.id ? 'voice-bar-anim' : ''}}" style="animation-delay:0.15s"></view>
              <view class="v-wave-bar {{playingId === item.id ? 'voice-bar-anim' : ''}}" style="animation-delay:0.3s"></view>
            </view>
            <image class="voice-play-icon" src="{{playingId === item.id ? '../../images/icon-pause.svg' : '../../images/icon-play.svg'}}" mode="aspectFit"></image>
          </view>
        </view>
      </block>

      <!-- ===== 图片消息（未撤回，非系统） ===== -->
      <block wx:if="{{item.type === 'image' && !item.recalled}}">
        <view class="chat-msg-row-left" wx:if="{{!item.isMine}}">
          <view class="chat-bubble chat-bubble-image" id="msg-bubble-{{index}}" bindtap="onPreviewImage" bindlongpress="onMsgLongPress" data-index="{{index}}" data-item="{{item}}">
            <image class="msg-image-thumb" src="{{item.content}}" mode="aspectFill" lazy-load="{{true}}"></image>
          </view>
        </view>
        <view class="chat-msg-row" wx:if="{{item.isMine}}">
          <view class="chat-retry-btn" wx:if="{{item.sendFailed}}" bindtap="onRetrySend" data-id="{{item.id}}">
            <text class="retry-icon">!</text>
          </view>
          <text class="chat-status-text" wx:elif="{{item.status === 'sending'}}">发送中</text>
          <view class="chat-bubble chat-bubble-image" id="msg-bubble-{{index}}" bindtap="onPreviewImage" bindlongpress="onMsgLongPress" data-index="{{index}}" data-item="{{item}}">
            <image class="msg-image-thumb" src="{{item.content}}" mode="aspectFill" lazy-load="{{true}}"></image>
          </view>
        </view>
      </block>

      <!-- ===== 文字消息（未撤回，非系统，非语音/图片） ===== -->
      <block wx:if="{{item.type !== 'voice' && item.type !== 'image' && item.type !== 'system' && !item.recalled}}">
        <view class="chat-msg-row-left" wx:if="{{!item.isMine}}">
          <view class="chat-bubble chat-bubble-left" id="msg-bubble-{{index}}" bindlongpress="onMsgLongPress" data-index="{{index}}" data-item="{{item}}">{{item.content}}</view>
        </view>
        <view class="chat-msg-row" wx:if="{{item.isMine}}">
          <view class="chat-retry-btn" wx:if="{{item.sendFailed}}" bindtap="onRetrySend" data-id="{{item.id}}">
            <text class="retry-icon">!</text>
          </view>
          <text class="chat-status-text" wx:elif="{{item.status === 'sending'}}">发送中</text>
          <text class="chat-status-text" wx:elif="{{item.status === 'failed'}}">发送失败</text>
          <view class="chat-bubble chat-bubble-right" id="msg-bubble-{{index}}" bindlongpress="onMsgLongPress" data-index="{{index}}" data-item="{{item}}">{{item.content}}</view>
        </view>
      </block>

    </block>
    <view id="msg-bottom"></view>
  </scroll-view>

  <!-- 录音浮层 — 360°方向性果冻形变（8 方位各独立 blob + 独立音量） -->
  <view class="record-overlay" wx:if="{{recording}}">
    <view class="record-mask"></view>
    <!-- 8 方位 blob 完美对称分布 · 各自独立音量 → 360° 均匀方向性突起 -->
    <view class="record-blobs">
      <view class="r-blob" style="transform: translate(0, -32rpx) scale({{1 + vN * 2.3}}); opacity: {{0.04 + vN * 0.08}}; background: {{recordCancelling ? 'rgba(255,59,48,0.50)' : 'rgba(52,199,89,0.50)'}};"></view>
      <view class="r-blob" style="transform: translate(23rpx, -23rpx) scale({{1 + vNE * 2.0}}); opacity: {{0.04 + vNE * 0.07}}; background: {{recordCancelling ? 'rgba(255,59,48,0.45)' : 'rgba(52,199,89,0.45)'}};"></view>
      <view class="r-blob" style="transform: translate(32rpx, 0) scale({{1 + vE * 2.3}}); opacity: {{0.04 + vE * 0.08}}; background: {{recordCancelling ? 'rgba(255,59,48,0.50)' : 'rgba(52,199,89,0.50)'}};"></view>
      <view class="r-blob" style="transform: translate(23rpx, 23rpx) scale({{1 + vSE * 2.0}}); opacity: {{0.04 + vSE * 0.07}}; background: {{recordCancelling ? 'rgba(255,59,48,0.45)' : 'rgba(52,199,89,0.45)'}};"></view>
      <view class="r-blob" style="transform: translate(0, 32rpx) scale({{1 + vS * 2.3}}); opacity: {{0.04 + vS * 0.08}}; background: {{recordCancelling ? 'rgba(255,59,48,0.50)' : 'rgba(52,199,89,0.50)'}};"></view>
      <view class="r-blob" style="transform: translate(-23rpx, 23rpx) scale({{1 + vSW * 2.0}}); opacity: {{0.04 + vSW * 0.07}}; background: {{recordCancelling ? 'rgba(255,59,48,0.45)' : 'rgba(52,199,89,0.45)'}};"></view>
      <view class="r-blob" style="transform: translate(-32rpx, 0) scale({{1 + vW * 2.3}}); opacity: {{0.04 + vW * 0.08}}; background: {{recordCancelling ? 'rgba(255,59,48,0.50)' : 'rgba(52,199,89,0.50)'}};"></view>
      <view class="r-blob" style="transform: translate(-23rpx, -23rpx) scale({{1 + vNW * 2.0}}); opacity: {{0.04 + vNW * 0.07}}; background: {{recordCancelling ? 'rgba(255,59,48,0.45)' : 'rgba(52,199,89,0.45)'}};"></view>
    </view>
    <!-- 中心白底圆 -->
    <view class="record-circle {{recordCancelling ? 'record-cancelling' : ''}}">
      <image class="record-mic-icon" src="../../images/icon-mic.svg" mode="aspectFit"></image>
    </view>
    <!-- 提示文字 -->
    <view class="record-label">
      <text class="record-time">{{recordDuration}}″</text>
      <text class="record-hint">{{recordCancelling ? '松开取消' : '松开发送，上滑取消'}}</text>
    </view>
  </view>

  <!-- 输入栏 -->
  <view class="chat-input-bar" style="bottom: {{keyboardHeight}}px;">

    <!-- 文字模式 -->
    <view class="chat-input-row" wx:if="{{inputMode === 'text'}}">
      <view class="chat-mic-btn" bindtap="onSwitchToVoice">
        <image src="../../images/icon-mic.svg" mode="aspectFit"></image>
      </view>
      <view class="chat-input-wrapper">
        <textarea class="chat-input" placeholder="输入消息..." placeholder-style="font-size:28rpx;color:rgba(120,120,128,0.6);" value="{{inputText}}" focus="{{inputFocus}}"
               bindinput="onInputChange" bindconfirm="onSend"
               bindkeyboardheightchange="onKeyboardHeightChange"
               bindblur="onInputBlur"
               bindlinechange="onInputLineChange"
               maxlength="1000" auto-height adjust-position="{{false}}" hold-keyboard="{{true}}"
               show-confirm-bar="{{false}}" confirm-type="send"
               disable-default-padding="{{true}}" />
        <view class="chat-send-icon" catchtap="onSend">
          <image class="send-icon-plane" src="../../images/icon-send.svg" mode="aspectFit"></image>
        </view>
      </view>
      <view class="chat-plus-btn" bindtap="onAttachMenu">
        <image src="../../images/plus-icon-gray.svg" mode="aspectFit"></image>
      </view>
    </view>

    <!-- 语音模式 -->
    <view class="chat-input-row" wx:if="{{inputMode === 'voice'}}">
      <view class="chat-keyboard-toggle" bindtap="onSwitchToText">
        <image src="../../images/icon-keyboard.svg" mode="aspectFit"></image>
      </view>
      <view class="chat-hold-to-talk"
            bindtouchstart="onRecordStart"
            bindtouchend="onRecordEnd"
            bindtouchcancel="onRecordCancel"
            bindtouchmove="onRecordTouchMove">
        <text>{{recording ? '松开发送' : '按住说话'}}</text>
      </view>
      <view class="chat-plus-btn" bindtap="onAttachMenu">
        <image src="../../images/plus-icon-gray.svg" mode="aspectFit"></image>
      </view>
    </view>

  </view>

  <!-- 悬浮操作菜单（长按消息气泡 → 出现在气泡正上方） -->
  <view class="msg-menu-overlay" wx:if="{{showMsgMenu}}" bindtap="onMsgMenuDismiss" catchtouchmove="preventTouchMove">
    <view class="msg-menu-popup" style="left: {{menuX}}px; top: {{menuY}}px;">
      <view class="msg-menu-item" wx:for="{{menuItems}}" wx:key="action" bindtap="onMsgMenuAction" data-action="{{item.action}}">
        {{item.label}}
      </view>
    </view>
  </view>

</view>
