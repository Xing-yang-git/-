<!-- 聊天页 — 对齐设计原型 chat.html -->
<view class="chat-page">

  <!-- 聊天消息区 -->
  <scroll-view class="chat-area" scroll-y scroll-into-view="{{scrollToView}}" scroll-with-animation enhanced show-scrollbar="{{false}}">

    <block wx:for="{{messages}}" wx:key="id">

      <!-- 时间分割线 -->
      <view class="chat-time-divider" wx:if="{{item.showTime}}">{{item.timeText}}</view>

      <!-- 系统消息（居中胶囊） -->
      <view class="chat-bubble-system" wx:if="{{item.type === 'system'}}">
        <text class="system-icon" wx:if="{{item.systemIcon}}">{{item.systemIcon}}</text>
        {{item.content}}
      </view>

      <!-- 对方消息（左气泡，无头像） -->
      <view class="chat-bubble chat-bubble-left" wx:if="{{!item.isMine && item.type !== 'system'}}">
        {{item.content}}
      </view>

      <!-- 我的消息（右气泡，无头像） -->
      <view class="chat-bubble chat-bubble-right" wx:if="{{item.isMine && item.type !== 'system'}}">
        {{item.content}}
      </view>

    </block>
    <view id="msg-bottom"></view>
  </scroll-view>

  <!-- 输入栏（全宽，纸飞机发送图标内置右侧） -->
  <view class="chat-input-bar">
    <view class="chat-input-wrapper">
      <input class="chat-input" placeholder="输入消息..." placeholder-style="font-size:28rpx;color:rgba(120,120,128,0.6);" value="{{inputText}}"
             bindinput="onInputChange" confirm-type="send" bindconfirm="onSend"
             maxlength="1000" adjust-position="{{false}}" />
      <view class="chat-send-icon" bindtap="onSend">
        <image class="send-icon-plane" src="../../images/icon-send.svg" mode="aspectFit"></image>
      </view>
    </view>
  </view>

</view>
