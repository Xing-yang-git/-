/* 小邻 — AI 智能助手对话页 */
.assistant-page {
  display: flex;
  flex-direction: column;
  height: 100vh;
  background: var(--bg);
}

/* ─── 自定义导航栏 ─── */
.assistant-nav {
  background: var(--surface);
  border-bottom: 1rpx solid var(--separator);
}

.assistant-nav-inner {
  display: flex;
  align-items: center;
  gap: 12rpx;
  height: 88rpx;
  padding: 0 32rpx;
}

.assistant-nav-title {
  font-size: var(--text-base);
  font-weight: 600;
  color: var(--text);   /* 标题「小邻」主文字色 */
}

.assistant-nav-sub {
  font-size: var(--text-xs);
  color: var(--text-tertiary);   /* 「智能助手」副标题弱化 */
}

/* ─── 消息区 ─── */
.msg-area {
  flex: 1;
  padding: 24rpx 32rpx;
  box-sizing: border-box;
}

/* 欢迎态 */
.welcome {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 120rpx 32rpx 40rpx;
}

.welcome-title {
  font-size: var(--text-2xl);
  font-weight: 600;
  color: var(--text);
}

.welcome-sub {
  margin-top: 16rpx;
  font-size: var(--text-sm);
  color: var(--text-secondary);
}

.suggestion-chips {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
  margin-top: 48rpx;
  width: 100%;
}

.chip {
  padding: 16rpx 28rpx;
  background: var(--surface);
  border: 1rpx solid var(--separator);
  border-radius: var(--radius-pill);
  font-size: var(--text-sm);
  color: var(--text);
}

/* 消息行 */
.msg-row {
  display: flex;
  margin-bottom: 24rpx;
}

.msg-row-left {
  justify-content: flex-start;
}

.msg-row-right {
  justify-content: flex-end;
}

.bubble {
  max-width: 70%;
  padding: 20rpx 24rpx;
  border-radius: var(--radius-lg);
  font-size: var(--text-md);
  line-height: 1.5;
  word-break: break-all;
}

.bubble-user {
  background: var(--blue);   /* 用户气泡品牌蓝底 */
  color: var(--surface);
  border-bottom-right-radius: 4rpx;   /* 仅右下小圆角区分方向 */
}

.bubble-ai {
  background: var(--surface);   /* AI 气泡白底 + 轻投影 */
  color: var(--text);
  border-bottom-left-radius: 4rpx;
  box-shadow: var(--shadow-sm);
}

.typing {
  display: inline-block;
  animation: blink 1s step-end infinite; /* blink 定义在 app.wxss 全局 keyframes（铁律：@keyframes 不入页面 WXSS） */
}

/* 引用来源 */
.sources {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  margin: -8rpx 0 16rpx 16rpx;
  max-width: 70%;
}

.source-item {
  font-size: var(--text-xs);
  color: var(--text-tertiary);
  background: var(--fill-tertiary);
  padding: 6rpx 14rpx;
  border-radius: var(--radius-sm);
}

/* 动作卡片（写操作确认入口） */
.action-card {
  display: flex;
  align-items: center;
  justify-content: space-between;
  max-width: 70%;
  margin: -8rpx 0 16rpx 16rpx;
  padding: 20rpx 24rpx;
  background: var(--surface);
  border: 1rpx solid var(--blue);
  border-radius: var(--radius);
  box-shadow: var(--shadow-sm);
}

.action-label {
  font-size: var(--text-sm);
  font-weight: 500;
  color: var(--blue);
}

.action-arrow {
  font-size: var(--text-sm);
  color: var(--text-tertiary);
}

.msg-bottom {
  height: 1px;
}

/* ─── 输入区 ─── */
.assistant-input-bar {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  background: var(--surface);
  border-top: 1rpx solid var(--separator);
  padding: 16rpx 24rpx calc(16rpx + env(safe-area-inset-bottom));
}

.input-row {
  display: flex;
  align-items: flex-end;
  gap: 16rpx;
}

.assistant-input {
  flex: 1;
  min-height: 72rpx;
  max-height: 200rpx;   /* 多行输入自动增高上限 */
  padding: 16rpx 24rpx;
  background: var(--bg);   /* 浅灰底区分于输入栏白底 */
  border-radius: var(--radius-pill);
  font-size: var(--text-md);
  color: var(--text);
  box-sizing: border-box;
}

.send-btn {
  flex-shrink: 0;
  height: 72rpx;
  padding: 0 32rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: var(--blue);
  color: var(--surface);
  font-size: var(--text-sm);
  font-weight: 500;
  border-radius: var(--radius-pill);
}

.send-btn-disabled {
  opacity: 0.5;
}
