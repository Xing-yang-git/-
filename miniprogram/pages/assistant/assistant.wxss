/* 小邻 — AI 智能助手对话页 */
.assistant-page {
  display: flex;
  flex-direction: column;
  height: 100vh;
  background: var(--bg);
}

/* ─── 自定义导航栏 ─── */
.assistant-nav {
  background: var(--surface);
  border-bottom: 1rpx solid var(--separator);
}

.assistant-nav-inner {
  display: flex;
  align-items: center;
  gap: 12rpx;
  height: 88rpx;
  padding: 0 32rpx;
}

.assistant-nav-title {
  font-size: var(--text-base);
  font-weight: 600;
  color: var(--text);   /* 标题「小邻」主文字色 */
}

.assistant-nav-sub {
  font-size: var(--text-xs);
  color: var(--text-tertiary);   /* 「智能助手」副标题弱化 */
}

.nav-spacer {
  flex: 1;
}

.nav-history-btn {
  font-size: var(--text-sm);
  color: var(--blue);
  padding: 8rpx 16rpx;
}

/* 返回按钮（对齐聊天页 nav-back 样式） */
.assistant-nav-back {
  display: flex;
  align-items: center;
  padding: 8rpx 16rpx 8rpx 0;
}

.assistant-nav-back-icon {
  font-size: 56rpx;
  line-height: 1;
  font-weight: 400;
  color: var(--text-secondary);
}

/* ─── 历史会话弹层 ─── */
.history-mask {
  position: fixed;
  inset: 0;
  background: rgba(0, 0, 0, 0.4);
  z-index: 90;
}

.history-sheet {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  max-height: 70vh;
  background: var(--surface);
  border-top-left-radius: var(--radius-xl);
  border-top-right-radius: var(--radius-xl);
  z-index: 91;
  display: flex;
  flex-direction: column;
}

.history-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 28rpx 32rpx;
  border-bottom: 1rpx solid var(--separator);
}

.history-title {
  font-size: var(--text-base);
  font-weight: 600;
  color: var(--text);
}

.history-actions {
  display: flex;
  gap: 24rpx;
}

.history-action {
  font-size: var(--text-sm);
  color: var(--blue);
}

.history-action.danger {
  color: var(--red);
}

.history-list {
  flex: 1;
  padding: 8rpx 0;
  max-height: 55vh;
}

.history-item {
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding: 24rpx 32rpx;
  border-bottom: 1rpx solid var(--separator);   /* 列表分隔线 */
}

.history-check {
  width: 40rpx;
}

.checkbox {
  width: 36rpx;
  height: 36rpx;
  border: 2rpx solid var(--text-quaternary);
  border-radius: 50%;
  box-sizing: border-box;
}

.checkbox.checked {
  background: var(--blue);
  border-color: var(--blue);
}

.history-info {
  flex: 1;
  min-width: 0;   /* 允许标题超长省略 */
}

.history-item-title {
  display: block;
  font-size: var(--text-md);
  color: var(--text);
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.history-item-meta {
  display: block;
  margin-top: 6rpx;
  font-size: var(--text-xs);
  color: var(--text-tertiary);
}

.history-item-status {
  font-size: var(--text-xs);
  color: var(--text-tertiary);
  flex-shrink: 0;
}

.history-empty {
  text-align: center;
  padding: 80rpx 0;
  font-size: var(--text-sm);
  color: var(--text-tertiary);
}

/* ─── 消息区 ─── */
.msg-area {
  flex: 1;
  padding: 24rpx 32rpx;
  box-sizing: border-box;
}

/* 欢迎态 */
.welcome {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 120rpx 32rpx 40rpx;
}

.welcome-title {
  font-size: var(--text-2xl);
  font-weight: 600;
  color: var(--text);
}

.welcome-sub {
  margin-top: 16rpx;
  font-size: var(--text-sm);
  color: var(--text-secondary);
}

.suggestion-chips {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
  margin-top: 48rpx;
  width: 100%;
}

.chip {
  padding: 16rpx 28rpx;
  background: var(--surface);
  border: 1rpx solid var(--separator);
  border-radius: var(--radius-pill);
  font-size: var(--text-sm);
  color: var(--text);
}

/* 消息行 */
.msg-row {
  display: flex;
  margin-bottom: 24rpx;
}

.msg-row-left {
  justify-content: flex-start;
}

.msg-row-right {
  justify-content: flex-end;
}

.bubble {
  max-width: 70%;
  padding: 20rpx 24rpx;
  border-radius: var(--radius-lg);
  font-size: var(--text-md);
  line-height: 1.5;
  word-break: break-all;
}

.bubble-user {
  background: var(--blue);   /* 用户气泡品牌蓝底 */
  color: var(--surface);
  border-bottom-right-radius: 4rpx;   /* 仅右下小圆角区分方向 */
}

.bubble-ai {
  background: var(--surface);   /* AI 气泡白底 + 轻投影 */
  color: var(--text);
  border-bottom-left-radius: 4rpx;
  box-shadow: var(--shadow-sm);
}

.typing {
  display: inline-block;
  animation: blink 1s step-end infinite; /* blink 定义在 app.wxss 全局 keyframes（铁律：@keyframes 不入页面 WXSS） */
}

/* 终止标记：灰色小字（用户点击终止后追加在正文下方，不污染正文） */
.abort-marker {
  display: block;
  margin-top: 8rpx;
  font-size: 22rpx;
  color: var(--text-tertiary);
}

/* 失败重试入口：超时/网络中断/出错时显示在 AI 气泡下方，点击原问题重发 */
.msg-retry {
  display: inline-block;
  margin: -8rpx 0 16rpx 16rpx;
  padding: 10rpx 20rpx;
  font-size: var(--text-xs);
  color: var(--blue);
  background: var(--fill-tertiary);
  border: 1rpx solid var(--separator);
  border-radius: var(--radius-sm);
}

/* 引用来源 */
.sources {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  margin: -8rpx 0 16rpx 16rpx;
  max-width: 70%;
}

.source-item {
  font-size: var(--text-xs);
  color: var(--text-tertiary);
  background: var(--fill-tertiary);
  padding: 6rpx 14rpx;
  border-radius: var(--radius-sm);
}

/* 动作卡片（写操作确认入口） */
.action-card {
  display: flex;
  align-items: center;
  justify-content: space-between;
  max-width: 70%;
  margin: -8rpx 0 16rpx 16rpx;
  padding: 20rpx 24rpx;
  background: var(--surface);
  border: 1rpx solid var(--blue);
  border-radius: var(--radius);
  box-shadow: var(--shadow-sm);
}

.action-label {
  font-size: var(--text-sm);
  font-weight: 500;
  color: var(--blue);
}

.action-arrow {
  font-size: var(--text-sm);
  color: var(--text-tertiary);
}

.msg-bottom {
  height: 1px;
}

