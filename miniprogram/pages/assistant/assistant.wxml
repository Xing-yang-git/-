<!-- 小邻 — AI 智能助手对话页 -->
<view class="assistant-page">

  <!-- 自定义导航栏 -->
  <view class="assistant-nav" style="padding-top: {{statusBarHeight}}px;">
    <view class="assistant-nav-inner">
      <text class="assistant-nav-title">小邻</text>
      <text class="assistant-nav-sub">智能助手</text>
      <view class="nav-spacer"></view>
      <view class="nav-history-btn" bindtap="onHistoryTap">历史</view>
    </view>
  </view>

  <!-- 历史会话弹层 -->
  <view class="history-mask" wx:if="{{historyVisible}}" bindtap="onCloseHistory"></view>
  <view class="history-sheet" wx:if="{{historyVisible}}">
    <view class="history-header">
      <text class="history-title">历史对话</text>
      <view class="history-actions">
        <text wx:if="{{selecting}}" class="history-action danger" bindtap="onBatchDelete">删除所选</text>
        <text class="history-action" bindtap="onCloseHistory">关闭</text>
      </view>
    </view>
    <scroll-view class="history-list" scroll-y bindscrolltolower="onHistoryScrollLower" lower-threshold="50">
      <view
        wx:for="{{historyList}}"
        wx:key="id"
        class="history-item"
        data-id="{{item.id}}"
        data-item="{{item}}"
        bindtap="onHistoryItemTap"
        bindlongpress="onHistoryLongPress"
      >
        <view class="history-check" wx:if="{{selecting}}">
          <view class="checkbox {{selectedIds.indexOf(item.id) > -1 ? 'checked' : ''}}"></view>
        </view>
        <view class="history-info">
          <text class="history-item-title">{{item.title}}</text>
          <text class="history-item-meta">{{item.messageCount}} 条 · {{item.updatedAtText}}</text>
        </view>
        <text wx:if="{{!selecting}}" class="history-item-status">归档</text>
      </view>
      <view class="history-empty" wx:if="{{historyList.length === 0}}">暂无历史对话</view>
    </scroll-view>
  </view>

  <!-- 消息区 -->
  <scroll-view class="msg-area" scroll-y scroll-into-view="{{scrollToView}}" scroll-with-animation
               enhanced show-scrollbar="{{false}}" style="padding-bottom: {{keyboardHeight + 20}}px;">

    <!-- 欢迎态 + 快捷问题（无消息时） -->
    <view class="welcome" wx:if="{{messages.length === 0}}">
      <text class="welcome-title">你好，我是小邻</text>
      <text class="welcome-sub">小区规则、平台使用、物品搜索，都可以问我</text>
      <view class="suggestion-chips">
        <view class="chip" wx:for="{{suggestions}}" wx:key="*this" data-msg="{{item}}" bindtap="onSuggestionTap">
          {{item}}
        </view>
      </view>
    </view>

    <!-- 消息气泡 -->
    <block wx:for="{{messages}}" wx:key="id">
      <view class="msg-row {{item.role === 'user' ? 'msg-row-right' : 'msg-row-left'}}">
        <view class="bubble {{item.role === 'user' ? 'bubble-user' : 'bubble-ai'}}">
          <text class="bubble-text">{{item.content}}<text class="typing" wx:if="{{item.streaming}}">▍</text></text>
        </view>
      </view>
      <!-- 引用来源（后端检索结果） -->
      <view class="sources" wx:if="{{item.sources.length > 0}}">
        <text class="source-item" wx:for="{{item.sources}}" wx:key="id" wx:for-item="src">参考：{{src.source}}</text>
      </view>
      <!-- 动作卡片（写操作，用户点击跳发布页预填） -->
      <view
        class="action-card"
        wx:if="{{item.actions.length > 0}}"
        wx:for="{{item.actions}}"
        wx:for-item="act"
        wx:key="type"
        data-action="{{act}}"
        bindtap="onActionTap"
      >
        <text class="action-label">{{act.label}}</text>
        <text class="action-arrow">去填写 ›</text>
      </view>
    </block>

    <view id="msg-bottom" class="msg-bottom"></view>
  </scroll-view>

  <!-- 输入区（键盘适配与 chat 页一致：keyboardHeight 抬升 + adjust-position:false + hold-keyboard） -->
  <view class="assistant-input-bar" style="bottom: {{keyboardHeight}}px;">
    <view class="input-row">
      <textarea class="assistant-input" placeholder="问小邻点什么…" value="{{inputText}}"
                placeholder-style="font-size:28rpx;color:rgba(120,120,128,0.6);"
                bindinput="onInputChange" bindconfirm="onSend"
                bindkeyboardheightchange="onKeyboardHeightChange"
                maxlength="500" adjust-position="{{false}}" hold-keyboard="{{true}}"
                show-confirm-bar="{{false}}" confirm-type="send"
                disable-default-padding="{{true}}" />
      <view class="send-btn {{sending ? 'send-btn-disabled' : ''}}" catchtap="onSend">
        <text>{{sending ? '…' : '发送'}}</text>
      </view>
    </view>
  </view>

</view>
