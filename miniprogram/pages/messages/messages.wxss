.container {
  min-height: 100vh;
  background: var(--bg);
  display: flex;
  flex-direction: column;
}

/* 会话列表 — flex-fill 使白色背景延伸到底部，即使会话较少时也填满（list-end 提示区随之保持同色白底） */
.session-list {
  flex: 1;
  background: var(--surface);
}

/* 行 — 对齐原型 .msg-item */
.session-item {
  display: flex;
  align-items: center;
  padding: 20rpx var(--margin);
  gap: 24rpx;
  min-height: 120rpx;
  background: var(--surface);
}

.session-item:active {
  background: var(--fill-quaternary);
}

/* 置顶会话 — 浅灰色背景区分 */
.session-item.pinned {
  background: var(--fill-tertiary);
}

/* 渐变极细分割线（两端淡出），对齐原型 .msg-item + .msg-item */
.session-item + .session-item {
  background-image: linear-gradient(to right, transparent 8%, var(--separator) 25%, var(--separator) 75%, transparent 92%);
  background-repeat: no-repeat;
  background-size: 100% 0.5px;
  background-position: top;
}

/* Avatar — 40px circle from app.wxss；统一用 👤 emoji（与求助详情页一致） */
.avatar {
  background: var(--fill-tertiary);
}

/* 信息列 */
.msg-info {
  flex: 1;
  min-width: 0;
}

.msg-name {
  font-size: var(--text-sm);
  font-weight: 400;
  color: var(--text);
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.msg-name.unread {
  font-weight: 500;
}

.msg-preview {
  font-size: var(--text-xs);
  color: var(--text-secondary);
  margin-top: 2rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

/* 未读语音消息预览 — 中深红色 */
.msg-preview.voice-preview-unread {
  color: var(--red);
}

/* 元数据列（右对齐时间 + 徽标） */
.msg-meta {
  text-align: right;
  flex-shrink: 0;
}

.msg-time {
  font-size: var(--text-xs);
  color: var(--text-tertiary);
}

.msg-badge {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  min-width: 36rpx;
  height: 36rpx;
  border-radius: 18rpx;
  background: var(--red);
  color: var(--surface);
  font-size: 22rpx;
  font-weight: 600;
  padding: 0 10rpx;
  margin-top: 8rpx;
}

/* 空状态 */
.empty-state {
  flex: 1;
  justify-content: center;
}

.empty-hint {
  font-size: var(--text-sm);
  color: var(--text-quaternary);
}
