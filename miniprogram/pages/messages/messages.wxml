<view class="container">
  <!-- 会话列表 -->
  <view class="session-list" wx:if="{{sessions.length > 0}}">
    <view
      class="session-item"
      wx:for="{{sessions}}"
      wx:key="id"
      bindtap="onSessionTap"
      data-id="{{item.id}}"
      data-name="{{item.otherName}}"
      data-room="{{item.roomInfo}}"
      data-about="{{item.aboutTitle}}"
      data-about-id="{{item.aboutId}}"
      data-about-type="{{item.aboutType}}"
      data-otheruserid="{{item.otherUserId}}"
    >
      <view class="avatar">👤</view>
      <view class="msg-info">
        <view class="msg-name {{item.isRead ? '' : 'unread'}}">{{item.otherName}}</view>
        <view class="msg-preview">{{item.lastMessage}}</view>
      </view>
      <view class="msg-meta">
        <view class="msg-time">{{item.timeText}}</view>
        <view class="msg-badge" wx:if="{{item.unreadCount > 0}}">{{item.unreadCount > 99 ? '99+' : item.unreadCount}}</view>
      </view>
    </view>
    <view class="list-end">— 全部会话 —</view>
  </view>
  <view class="empty-state" wx:else>
    <!-- Empty State：wx:else 须与上方 wx:if 节点直接相邻，注释不能夹在两节点之间 -->
    <view class="empty-icon">💬</view>
    <text class="empty-text">暂无消息</text>
    <text class="empty-hint">去社区逛逛，开始一段对话吧</text>
  </view>
</view>
