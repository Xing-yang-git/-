.login-page {
  min-height: 100vh;
  background: var(--bg);
  display: flex;
  flex-direction: column;
}

.login-body {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 96rpx 64rpx;
  text-align: center;
  position: relative;
}

.login-header {
  position: absolute;
  top: 10vh;
  left: 0;
  right: 0;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.login-footer {
  display: flex;
  flex-direction: column;
  align-items: center;
  margin-top: 500rpx;
  width: 100vw;
}

.login-icon-area {
  margin-bottom: 48rpx;
}

.login-icon {
  width: 160rpx;
  height: 160rpx;
  border-radius: 40rpx;
  background: var(--blue);
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 16rpx 48rpx rgba(0, 113, 227, 0.25);
}

.login-icon-img {
  width: 80rpx;
  height: 80rpx;
}

.login-title {
  font-size: var(--text-2xl);
  font-weight: 700;
  color: var(--text);
  margin-bottom: 88rpx;
  letter-spacing: 0.01em;
}

.login-btn{
  width: 100%;
  margin-top: 40rpx;
  margin-bottom: 20rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.wx-btn {
  width: 65%;
  height: 100rpx;
  border-radius: 50rpx;
  background: var(--blue);
  color: var(--surface);
  font-size: var(--text-base);
  font-weight: 600;
  box-shadow: 0 8rpx 28rpx rgba(0, 113, 227, 0.3);
  line-height: 100rpx;
  transition: opacity var(--motion-fast) var(--ease);
}

.wx-btn::after {
  border: none;
}

.wx-btn:active {
  opacity: 0.8;
  transform: scale(0.98);
}

.privacy-row {
  display: flex;
  align-items: center;
  gap: 8rpx;
}

.privacy-text {
  font-size: var(--text-xs);
  color: var(--text-tertiary);
  line-height: 1.8;
}

.privacy-link {
  color: var(--blue);
}

/* ── 密码登录切换链接 ── */
.switch-login {
  font-size: var(--text-sm);
  color: var(--text-tertiary);
  padding: 16rpx 0;
  margin: 0 0 40rpx 200rpx;
}

/* ── 小区选择器 ── */
.tenant-picker {
  width: 65%;
  height: 100rpx;
  margin-bottom: 32rpx;
  border-radius: 50rpx;
  background: var(--surface);
}

.tenant-picker-inner {
  width: 100%;
  height: 100rpx;
  line-height: 100rpx;
  padding: 0 32rpx;
  text-align: left;
  box-sizing: border-box;
  font-size: var(--text-base);
  color: var(--text);
}

.tenant-picker-inner.placeholder {
  color: var(--text-tertiary);
}

/* ── 手机号输入组 ── */
.phone-input-group {
  display: flex;
  align-items: center;
  width: 65%;
  height: 100rpx;
  border-radius: 50rpx;
  background: var(--surface);
  margin-bottom: 32rpx;
  padding: 0 32rpx 0 30rpx;
  box-sizing: border-box;
}

.phone-prefix {
  font-size: var(--text-base);
  color: var(--text-secondary);
  font-weight: 500;
  margin-right: 24rpx;
  flex-shrink: 0;
}

.phone-input {
  flex: 1;
  height: 100rpx;
  font-size: var(--text-base);
  color: var(--text);
  background: transparent;
  text-align: left;
}

/* ── 密码输入组 ── */
.password-input-group {
  display: flex;
  align-items: center;
  width: 65%;
  height: 100rpx;
  border-radius: 50rpx;
  background: var(--surface);
  margin-bottom: 32rpx;
  padding: 0 32rpx;
  box-sizing: border-box;
}

.password-input {
  flex: 1;
  height: 100rpx;
  font-size: var(--text-base);
  color: var(--text);
  background: transparent;
  text-align: left;
}

.toggle-password {
  font-size: 40rpx;
  color: var(--text-secondary);
  flex-shrink: 0;
  padding: 12rpx 4rpx 12rpx 16rpx;
}
