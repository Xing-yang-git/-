.login-page {
  min-height: 100vh;
  background: var(--bg);
  display: flex;
  flex-direction: column;
}

.login-body {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 48px 32px;
  text-align: center;
  position: relative;
}

.login-header {
  position: absolute;
  top: 10vh;
  left: 0;
  right: 0;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.login-footer {
  display: flex;
  flex-direction: column;
  align-items: center;
  margin-top: 250px;
  width: 100vw;
}

.login-icon-area {
  margin-bottom: 24px;
}

.login-icon {
  width: 80px;
  height: 80px;
  border-radius: 20px;
  background: var(--blue);
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 8px 24px rgba(0, 113, 227, 0.25);
}

.login-icon-img {
  width: 40px;
  height: 40px;
}

.login-title {
  font-size: var(--text-2xl);
  font-weight: 700;
  color: var(--text);
  margin-bottom: 44px;
  letter-spacing: 0.01em;
}

.login-btn{
  width: 100%;
  margin-top: 20px;
  margin-bottom: 10px;
  display: flex;
  align-items: center;
  justify-content: center;
}

.wx-btn {
  width: 65%;
  height: 50px;
  border-radius: 50rpx;
  background: var(--blue);
  color: var(--surface);
  font-size: var(--text-base);
  font-weight: 600;
  box-shadow: 0 4px 14px rgba(0, 113, 227, 0.3);
  line-height: 50px;
  transition: opacity var(--motion-fast) var(--ease);
}

.wx-btn::after {
  border: none;
}

.wx-btn:active {
  opacity: 0.8;
  transform: scale(0.98);
}

.privacy-row {
  display: flex;
  align-items: center;
  gap: 4px;
}

.privacy-text {
  font-size: var(--text-xs);
  color: var(--text-tertiary);
  line-height: 1.8;
}

.privacy-link {
  color: var(--blue);
}

/* ── 密码登录切换链接 ── */
.switch-login {
  font-size: var(--text-sm);
  color: var(--text-tertiary);
  padding: 8px 0;
  margin: 0 0 20px 100px;
}

/* ── 小区选择器 ── */
.tenant-picker {
  width: 65%;
  height: 50px;
  margin-bottom: 16px;
  border-radius: 50rpx;
  background: #ffffff;
}

.tenant-picker-inner {
  width: 100%;
  height: 50px;
  line-height: 50px;
  padding: 0 16px;
  text-align: left;
  box-sizing: border-box;
  font-size: var(--text-base);
  color: var(--text);
}

.tenant-picker-inner.placeholder {
  color: var(--text-tertiary);
}

/* ── 手机号输入组 ── */
.phone-input-group {
  display: flex;
  align-items: center;
  width: 65%;
  height: 50px;
  border-radius: 50rpx;
  background: #ffffff;
  margin-bottom: 16px;
  padding: 0 16px 0 15px;
  box-sizing: border-box;
}

.phone-prefix {
  font-size: var(--text-base);
  color: var(--text-secondary);
  font-weight: 500;
  margin-right: 12px;
  flex-shrink: 0;
}

.phone-input {
  flex: 1;
  height: 50px;
  font-size: var(--text-base);
  color: var(--text);
  background: transparent;
  text-align: left;
}

/* ── 密码输入组 ── */
.password-input-group {
  display: flex;
  align-items: center;
  width: 65%;
  height: 50px;
  border-radius: 50rpx;
  background: #ffffff;
  margin-bottom: 16px;
  padding: 0 16px;
  box-sizing: border-box;
}

.password-input {
  flex: 1;
  height: 50px;
  font-size: var(--text-base);
  color: var(--text);
  background: transparent;
  text-align: left;
}

.toggle-password {
  font-size: 40rpx;
  color: var(--text-secondary);
  flex-shrink: 0;
  padding: 12rpx 4rpx 12rpx 16rpx;
}
