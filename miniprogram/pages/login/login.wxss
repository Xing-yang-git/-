.login-page {
  min-height: 100vh;
  background: var(--bg);
  display: flex;
  flex-direction: column;
}

.login-body {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 48px 32px;
  text-align: center;
  position: relative;
}

.login-header {
  position: absolute;
  top: 20vh;
  left: 0;
  right: 0;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.login-footer {
  position: absolute;
  bottom: 20vh;
  left: 32px;
  right: 32px;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.login-icon-area {
  margin-bottom: 24px;
}

.login-icon {
  width: 80px;
  height: 80px;
  border-radius: 20px;
  background: var(--blue);
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 8px 24px rgba(0, 113, 227, 0.25);
}

.login-icon-img {
  width: 40px;
  height: 40px;
}

.login-title {
  font-size: var(--text-2xl);
  font-weight: 700;
  color: var(--text);
  margin-bottom: 44px;
  letter-spacing: 0.01em;
}

.wx-btn {
  width: 140%;
  height: 50px;
  border-radius: 50rpx;
  background: var(--blue);
  color: var(--surface);
  font-size: var(--text-base);
  font-weight: 600;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 20px;
  border: none;
  box-shadow: 0 4px 14px rgba(0, 113, 227, 0.3);
  padding: 0;
  line-height: 50px;
  transition: opacity var(--motion-fast) var(--ease);
}

.wx-btn::after {
  border: none;
}

.wx-btn:active {
  opacity: 0.8;
  transform: scale(0.98);
}

.privacy-row {
  display: flex;
  align-items: center;
  gap: 4px;
}

.privacy-text {
  font-size: var(--text-xs);
  color: var(--text-tertiary);
  line-height: 1.8;
}

.privacy-link {
  color: var(--blue);
}
