.search-page {
  min-height: 100vh;
  display: flex;
  flex-direction: column;
  background: var(--bg);
}

/* 搜索头部 — 对齐原型 .nav-bar，44px 高度 */
.search-header {
  display: flex;
  align-items: center;
  padding: 8rpx var(--margin);
  background: var(--surface);
  gap: 16rpx;
  height: 88rpx;
}

/* 确保搜索容器填充可用空间（原型使用内联 flex:1） */
.search-header .search-input-wrap {
  flex: 1;
}

/* 搜索输入容器 — 对齐原型 .search-input-wrap：圆角背景 + 内部 flex 水平排列 */
.search-input-wrap {
  display: flex;
  align-items: center;
  background: var(--fill-tertiary);
  border-radius: 20rpx;
  padding: 0 16rpx;
  height: 72rpx;
}

/* 搜索图标 — 对齐原型 .search-input-wrap .search-icon */
.search-icon {
  width: 36rpx;
  height: 36rpx;
  margin-right: 12rpx;
  flex-shrink: 0;
  opacity: 0.4;
}

.search-input {
  flex: 1;
  border: none;
  background: transparent;
  font-size: var(--text-base);
  height: 100%;
}

/* 清除按钮容器 — 加大点击热区，事件绑定在 view 上确保可靠触发 */
.search-clear {
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 16rpx;
  flex-shrink: 0;
}

/* 清除图标 — 深灰色 X */
.search-clear-icon {
  width: 44rpx;
  height: 44rpx;
}

.search-body {
  flex: 1;
  background: var(--bg);
}

/* 分组区域（搜索历史） */
.section {
  padding: var(--space-4);
}

.section-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 16rpx;
}

.section-title {
  font-size: var(--text-sm);
  color: var(--text-secondary);
}

.section-action {
  font-size: var(--text-sm);
  color: var(--blue);
}

/* 热搜胶囊 — 对齐原型内联样式 */
.pill-hot {
  background: rgba(255, 59, 48, 0.08);
  color: var(--red);
}

/* 筛选标签 — 对齐原型 .segment 模式 */
.filter-tabs {
  display: flex;
  background: var(--bg);
  border-radius: 16rpx;
  padding: 4rpx;
  margin: 16rpx var(--margin);
}

.filter-tab {
  flex: 1;
  text-align: center;
  padding: 12rpx 0;
  font-size: var(--text-sm);
  font-weight: 500;
  color: var(--text-secondary);
  border-radius: 14rpx;
  transition: all var(--motion-fast) var(--ease);
}

.filter-tab.active {
  background: var(--surface);
  color: var(--text);
  box-shadow: var(--shadow-sm);
}

/* 结果数量 */
.result-count {
  padding: 16rpx var(--margin);
  font-size: 26rpx;
  color: var(--text-secondary);
}

/* 结果列表 */
.result-list {
  background: var(--surface);
}

/* 结果卡片 — 对齐原型 .card-h-ios 组件 */
.list-card {
  display: flex;
  padding: 24rpx var(--margin);
  background: var(--surface);
  gap: 24rpx;
  align-items: center;
}

.list-card:active {
  background: var(--fill-quaternary);
}

.list-card + .list-card {
  border-top: 0.5px solid var(--separator);
}

/* 缩略图 — 对齐原型 .card-h-img：72x72，圆角 8px */
.thumb {
  width: 144rpx;
  height: 144rpx;
  border-radius: 16rpx;
  background: var(--fill-tertiary);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 56rpx;
  flex-shrink: 0;
  overflow: hidden;
}

.info {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
  justify-content: center;
  gap: 8rpx;
}

/* 标题 — 匹配原型搜索结果样式：不加粗，14px */
.card-title {
  font-size: 28rpx;
  font-weight: 400;
  color: var(--text);
  line-height: 1.3;
  display: -webkit-box;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
  overflow: hidden;
}

/* 关键字高亮色 */
.card-title .highlight {
  color: var(--blue);
}

/* 元信息 — 对齐原型 .card-h-meta：13px */
.card-meta {
  font-size: var(--text-sm);
  color: var(--text-secondary);
}

/* 空历史 — 垂直居中 */
.empty-history {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding-top: 35vh;
}

.empty-history .empty-text {
  font-size: 30rpx;
  color: var(--text-secondary);
}

