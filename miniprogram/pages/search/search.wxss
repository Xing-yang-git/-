.search-page {
  min-height: 100vh;
  display: flex;
  flex-direction: column;
  background: var(--bg);
}

/* Search header — matches prototype .nav-bar at 44px height */
.search-header {
  display: flex;
  align-items: center;
  padding: 4px var(--margin);
  background: var(--surface);
  gap: 8px;
  height: 44px;
}

/* Ensure search wrap fills available space (prototype uses inline flex:1) */
.search-header .search-input-wrap {
  flex: 1;
}

.search-input {
  flex: 1;
  font-size: var(--text-base);
}

.search-clear {
  width: 28rpx;
  height: 28rpx;
  padding: 8rpx;
  flex-shrink: 0;
}

.search-body {
  flex: 1;
  background: var(--bg);
}

/* Section (search history) */
.section {
  padding: var(--space-4);
}

.section-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 8px;
}

.section-title {
  font-size: var(--text-sm);
  color: var(--text-secondary);
}

.section-action {
  font-size: var(--text-sm);
  color: var(--blue);
}

/* Hot search pill — matches prototype inline style */
.pill-hot {
  background: rgba(255, 59, 48, 0.08);
  color: var(--red);
}

/* Filter tabs — matched to prototype .segment pattern */
.filter-tabs {
  display: flex;
  background: var(--bg);
  border-radius: 8px;
  padding: 2px;
  margin: 8px var(--margin);
}

.filter-tab {
  flex: 1;
  text-align: center;
  padding: 6px 0;
  font-size: var(--text-sm);
  font-weight: 500;
  color: var(--text-secondary);
  border-radius: 7px;
  transition: all var(--motion-fast) var(--ease);
}

.filter-tab.active {
  background: var(--surface);
  color: var(--text);
  box-shadow: var(--shadow-sm);
}

/* Result count */
.result-count {
  padding: 8px var(--margin);
  font-size: 13px;
  color: var(--text-secondary);
}

/* Result list */
.result-list {
  background: var(--surface);
}

/* Result card — aligned to prototype .card-h-ios component */
.list-card {
  display: flex;
  padding: 12px var(--margin);
  background: var(--surface);
  gap: 12px;
  align-items: center;
}

.list-card:active {
  background: var(--fill-quaternary);
}

.list-card + .list-card {
  border-top: 0.5px solid var(--separator);
}

/* Thumb — matches prototype .card-h-img: 72x72, border-radius 8px */
.thumb {
  width: 144rpx;
  height: 144rpx;
  border-radius: 16rpx;
  background: var(--fill-tertiary);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 56rpx;
  flex-shrink: 0;
  overflow: hidden;
}

.info {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
  justify-content: center;
  gap: 4px;
}

/* Title — matches prototype .card-h-title: 17px, weight 500 */
.card-title {
  font-size: var(--text-base);
  font-weight: 500;
  color: var(--text);
  line-height: 1.3;
  display: -webkit-box;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
  overflow: hidden;
}

/* Meta — matches prototype .card-h-meta: 13px */
.card-meta {
  font-size: var(--text-sm);
  color: var(--text-secondary);
}

/* Empty history — vertically centered */
.empty-history {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding-top: 35vh;
}

.empty-history .empty-text {
  font-size: 15px;
  color: var(--text-secondary);
}

