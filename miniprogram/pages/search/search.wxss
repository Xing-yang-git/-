.search-page {
  min-height: 100vh;
  display: flex;
  flex-direction: column;
  background: var(--bg);
}

/* 搜索头部 — 对齐原型 .nav-bar，44px 高度 */
.search-header {
  display: flex;
  align-items: center;
  padding: 4px var(--margin);
  background: var(--surface);
  gap: 8px;
  height: 44px;
}

/* 确保搜索容器填充可用空间（原型使用内联 flex:1） */
.search-header .search-input-wrap {
  flex: 1;
}

.search-input {
  flex: 1;
  font-size: var(--text-base);
}

.search-clear {
  width: 36rpx;
  height: 36rpx;
  padding: 24rpx 20rpx 24rpx 24rpx;
  margin: -24rpx -20rpx -24rpx 0;
  flex-shrink: 0;
}

.search-body {
  flex: 1;
  background: var(--bg);
}

/* 分组区域（搜索历史） */
.section {
  padding: var(--space-4);
}

.section-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 8px;
}

.section-title {
  font-size: var(--text-sm);
  color: var(--text-secondary);
}

.section-action {
  font-size: var(--text-sm);
  color: var(--blue);
}

/* 热搜胶囊 — 对齐原型内联样式 */
.pill-hot {
  background: rgba(255, 59, 48, 0.08);
  color: var(--red);
}

/* 筛选标签 — 对齐原型 .segment 模式 */
.filter-tabs {
  display: flex;
  background: var(--bg);
  border-radius: 8px;
  padding: 2px;
  margin: 8px var(--margin);
}

.filter-tab {
  flex: 1;
  text-align: center;
  padding: 6px 0;
  font-size: var(--text-sm);
  font-weight: 500;
  color: var(--text-secondary);
  border-radius: 7px;
  transition: all var(--motion-fast) var(--ease);
}

.filter-tab.active {
  background: var(--surface);
  color: var(--text);
  box-shadow: var(--shadow-sm);
}

/* 结果数量 */
.result-count {
  padding: 8px var(--margin);
  font-size: 13px;
  color: var(--text-secondary);
}

/* 结果列表 */
.result-list {
  background: var(--surface);
}

/* 结果卡片 — 对齐原型 .card-h-ios 组件 */
.list-card {
  display: flex;
  padding: 12px var(--margin);
  background: var(--surface);
  gap: 12px;
  align-items: center;
}

.list-card:active {
  background: var(--fill-quaternary);
}

.list-card + .list-card {
  border-top: 0.5px solid var(--separator);
}

/* 缩略图 — 对齐原型 .card-h-img：72x72，圆角 8px */
.thumb {
  width: 144rpx;
  height: 144rpx;
  border-radius: 16rpx;
  background: var(--fill-tertiary);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 56rpx;
  flex-shrink: 0;
  overflow: hidden;
}

.info {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
  justify-content: center;
  gap: 4px;
}

/* 标题 — 对齐原型 .card-h-title：17px，weight 500 */
.card-title {
  font-size: var(--text-base);
  font-weight: 500;
  color: var(--text);
  line-height: 1.3;
  display: -webkit-box;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
  overflow: hidden;
}

/* 元信息 — 对齐原型 .card-h-meta：13px */
.card-meta {
  font-size: var(--text-sm);
  color: var(--text-secondary);
}

/* 空历史 — 垂直居中 */
.empty-history {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding-top: 35vh;
}

.empty-history .empty-text {
  font-size: 15px;
  color: var(--text-secondary);
}

