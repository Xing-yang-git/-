/* 服务通知详情页样式 */

.container {
  min-height: 100vh;
  background: var(--bg);
  display: flex;
  flex-direction: column;
}

/* 通知列表 */
.notice-list {
  flex: 1;
  padding: 24rpx var(--margin);
}

/* 内层容器 */
.notice-inner {
  display: flex;
  flex-direction: column;
}

/* 通知卡片 */
.notice-card {
  background: var(--surface);
  border-radius: 24rpx;
  padding: 32rpx;
  margin-bottom: 20rpx;
}

.notice-card-tappable {
  position: relative;
}

.notice-card-tappable:active {
  background: var(--fill-quaternary);
}

/* 通知时间（卡片外部上方，绝对时间格式：7月21日 12:00） */
.notice-datetime {
  font-size: 24rpx;
  color: var(--text-tertiary);
  text-align: center;
  margin-top: 32rpx;
  margin-bottom: 20rpx;
}

.notice-card-title {
  font-size: 30rpx;
  font-weight: 600;
  color: var(--text);
  margin-bottom: 12rpx;
  line-height: 1.4;
}

.notice-card-content {
  font-size: 26rpx;
  color: var(--text-secondary);
  line-height: 1.5;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  overflow: hidden;
}

.notice-card-footer {
  display: flex;
  align-items: center;
  justify-content: flex-end;
  margin-top: 20rpx;
}

.notice-card-time {
  font-size: 22rpx;
  color: var(--text-tertiary);
}

.notice-card-arrow {
  font-size: 26rpx;
  color: var(--blue);
}

.notice-card-rate {
  font-size: 26rpx;
  color: var(--red);
  font-weight: 500;
}

.notice-card-rated {
  font-size: 26rpx;
  color: var(--text-tertiary);
}

.notice-card-expired {
  font-size: 26rpx;
  color: var(--text-tertiary);
}

.notice-card-rejected {
  font-size: 26rpx;
  color: var(--text-tertiary);
}

/* 空状态 */
.empty-state {
  padding: 160rpx 40rpx;
  text-align: center;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.empty-icon {
  font-size: 96rpx;
  margin-bottom: 32rpx;
}

.empty-text {
  font-size: 30rpx;
  color: var(--text-secondary);
  margin-bottom: 16rpx;
}

.empty-hint {
  font-size: 24rpx;
  color: var(--text-tertiary);
}

.list-end {
  text-align: center;
  padding: 40rpx;
  font-size: 24rpx;
  color: var(--text-tertiary);
}

/* loading */
.global-loading {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
}

.loading-spinner {
  width: 64rpx;
  height: 64rpx;
  border: 6rpx solid var(--fill-tertiary);
  border-top-color: var(--blue);
  border-radius: 50%;
  animation: spin 0.8s linear infinite;
}

.loading-text {
  margin-top: 24rpx;
  font-size: 26rpx;
  color: var(--text-tertiary);
}
