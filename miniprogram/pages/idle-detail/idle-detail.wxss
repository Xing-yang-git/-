.detail-page {
  min-height: 100vh;
  display: flex;
  flex-direction: column;
  background: var(--bg);
}

/* Status banner — default (borrowed): orange */
.status-banner {
  padding: 10px 16px;
  text-align: center;
  font-size: 14px;
  color: var(--orange);
  background: rgba(255, 149, 0, 0.08);
}

/* Status banner — reserved: red */
.status-banner.status-banner-reserved {
  color: var(--red);
  background: rgba(255, 59, 48, 0.06);
}

/* Image carousel — override global .img-carousel (280px, #1C1C1E) */
swiper {
  width: 100%;
  height: 280px;
}

.carousel-image {
  width: 100%;
  height: 280px;
}

.carousel-slide {
  width: 100%;
  height: 280px;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  background: #1C1C1E;
}

.carousel-icon {
  font-size: 72px;
  color: rgba(255, 255, 255, 0.6);
}

.carousel-caption {
  font-size: 13px;
  color: rgba(255, 255, 255, 0.7);
  margin-top: 8px;
}

.page-content {
  flex: 1;
  background: var(--bg);
  padding-bottom: 100px;
}

.section-ios {
  padding: 16px;
  background: var(--surface);
  margin-bottom: 8px;
}

/* Callout inside section — match prototype inline margin override */
.section-ios .callout {
  margin: 12px 0 0;
}

.detail-title {
  font-size: 22px;
  font-weight: 700;
  color: var(--text);
  line-height: 1.3;
  margin-bottom: 8px;
  letter-spacing: 0.01em;
}

.detail-desc {
  font-size: 17px;
  color: var(--text-secondary);
  line-height: 1.55;
}

.detail-tags {
  display: flex;
  gap: 8px;
  margin-top: 12px;
  flex-wrap: wrap;
}

/* Publisher section */
.pub-header {
  display: flex;
  align-items: center;
  gap: 12px;
}

.pub-header .avatar {
  background: var(--fill-tertiary);
}

.pub-info {
  flex: 1;
}

.pub-name {
  font-size: 17px;
  font-weight: 500;
  color: var(--text);
}

.pub-meta {
  font-size: 13px;
  color: var(--text-secondary);
  margin-top: 2px;
}

.link-text {
  font-size: 13px;
  color: var(--blue);
}

/* Action bar — fixed at bottom */
.action-bar {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  z-index: 100;
  background: var(--surface);
  display: flex;
  gap: 12px;
  padding: 12px 16px;
  padding-bottom: calc(8px + var(--safe-bottom));
}

/* Action bar buttons — match prototype .btn styles */
.action-btn {
  flex: 1;
  height: 44px;
  border-radius: 8px;
  font-size: 17px;
  font-weight: 500;
  display: flex;
  align-items: center;
  justify-content: center;
  border: none;
  line-height: 44px;
  padding: 0 20px;
  letter-spacing: -0.01em;
}

.action-btn::after {
  border: none;
}

.action-btn-primary {
  background: var(--blue);
  color: #FFFFFF;
}

.action-btn-primary[disabled] {
  opacity: 0.35;
}

.action-btn-secondary {
  background: var(--fill-tertiary);
  color: var(--text);
}

/* Borrow summary (sheet top) — matching publish page .info-row pattern */
.borrow-summary {
  padding: 16rpx 0 0;
}

.borrow-summary-row {
  display: flex;
  align-items: baseline;
  padding: 6rpx 0;
}

.borrow-summary-label {
  width: 140rpx;
  flex-shrink: 0;
  font-size: var(--text-sm);
  color: var(--text-secondary);
}

.borrow-summary-value {
  flex: 1;
  font-size: var(--text-sm);
  color: var(--text);
}

/* Required asterisk (same as publish page) */
.required {
  color: var(--red);
}

/* Select / Picker in sheet — matching publish page .select-wrap + .select */
.select-wrap {
  margin-top: 16rpx;
}

.select {
  width: 100%;
  height: 88rpx;
  padding: 0 24rpx;
  border: none;
  border-radius: var(--radius-sm);
  font-size: var(--text-base);
  background: var(--fill-tertiary);
  color: var(--text);
  display: flex;
  align-items: center;
  box-sizing: border-box;
}

/* Sheet footer buttons — match prototype inline flex:1 */
.sheet-footer .btn {
  flex: 1;
}

/* ============================================================
   History Sheet — matching my-posts approval sheet layout
   ============================================================ */
.history-sheet-overlay {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.3);
  z-index: 1000;
  animation: fadeIn var(--motion-base) var(--ease);
}

.history-sheet {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  max-height: 80vh;
  display: flex;
  flex-direction: column;
  overflow: hidden;
  background: var(--surface);
  border-radius: var(--radius-lg) var(--radius-lg) 0 0;
  animation: slideUp var(--motion-base) var(--ease-out);
  z-index: 1001;
}

/* --- Header --- */
.history-sheet-header {
  flex-shrink: 0;
  background: var(--surface);
  border-radius: var(--radius-lg) var(--radius-lg) 0 0;
}

.history-sheet-handle {
  width: 72rpx;
  height: 10rpx;
  border-radius: 6rpx;
  background: var(--fill-primary);
  margin: 16rpx auto 0;
}

.history-sheet-title {
  font-size: var(--text-base);
  font-weight: 600;
  text-align: center;
  padding: 24rpx 0;
  color: var(--text);
}

/* --- Scrollable body --- */
.history-sheet-body {
  flex: 1;
  min-height: 0;
  padding: 0 var(--margin);
}

/* --- Section --- */
.history-section {
  margin-bottom: var(--space-6);
}

.history-section-label {
  display: block;
  font-size: var(--text-xs);
  color: var(--text-secondary);
  margin-bottom: 12rpx;
  letter-spacing: 0.02em;
}

/* --- Resident card --- */
.history-resident-card {
  background: var(--fill-quaternary);
  border-radius: var(--radius);
  padding: 24rpx;
}

.history-resident-row {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
}

.history-resident-addr {
  font-size: var(--text-sm);
  color: var(--text);
}

.history-rating-inline {
  display: flex;
  align-items: baseline;
  gap: 20rpx;
  flex-shrink: 0;
}

.history-rating-score-row {
  display: flex;
  align-items: baseline;
  gap: 4rpx;
}

.history-rating-label {
  font-size: var(--text-xs);
  color: var(--text-secondary);
}

.history-rating-value {
  font-size: var(--text-xl);
  font-weight: 600;
  color: var(--orange);
}

.history-rating-unit {
  font-size: var(--text-xs);
  color: var(--text-secondary);
}

/* --- Stats grid --- */
.history-stats-grid {
  display: flex;
  flex-wrap: wrap;
  background: var(--fill-quaternary);
  border-radius: var(--radius);
  padding: 24rpx 16rpx;
}

.history-stat-item {
  width: 33.33%;
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 16rpx 0;
}

.history-stat-half {
  width: 50%;
}

.history-stat-value {
  font-size: var(--text-base);
  font-weight: 600;
  color: var(--text);
}

.history-stat-label {
  font-size: var(--text-xs);
  color: var(--text-secondary);
  margin-top: 4rpx;
}

/* Missing global utility classes — match prototype definitions */
.input-group {
  margin-bottom: var(--space-4);
}

.input-label {
  display: block;
  font-size: var(--text-sm);
  color: var(--text-secondary);
  margin-bottom: 6px;
  letter-spacing: -0.01em;
}

.input {
  width: 100%;
  height: 44px;
  padding: 0 12px;
  border: none;
  border-radius: var(--radius-sm);
  font-size: var(--text-base);
  background: var(--fill-tertiary);
}

.textarea {
  width: 100%;
  min-height: 100px;
  padding: 10px 12px;
  border: none;
  border-radius: var(--radius-sm);
  font-size: var(--text-base);
  background: var(--fill-tertiary);
}

/* ============================================================
   Borrow Sheet — fixed footer (overrides global .sheet defaults)
   ============================================================ */
.borrow-sheet {
  display: flex;
  flex-direction: column;
  overflow: hidden; /* override global overflow-y:auto */
}

.borrow-sheet-body {
  flex: 1;
  min-height: 0;
  padding: 0 20px;
  box-sizing: border-box;
}

.borrow-sheet-footer {
  flex-shrink: 0;
  display: flex;
  gap: 12px;
  padding: var(--space-4);
  padding-bottom: calc(var(--space-4) + var(--safe-bottom));
  background: var(--surface);
}
