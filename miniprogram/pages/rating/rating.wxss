.container {
  padding: 16px;
  background: var(--bg);
  min-height: 100vh;
}

/* Header */
.rating-header {
  text-align: center;
  padding: 30px 0 20px;
}

.header-text {
  font-size: 20px;
  font-weight: 600;
  color: var(--text);
  display: block;
}

.header-type {
  font-size: 13px;
  color: var(--text-tertiary);
  margin-top: 6px;
  display: block;
}

/* Card title override */
.card-title {
  text-align: center;
}

/* Star Row */
.star-row {
  display: flex;
  justify-content: center;
  gap: 8px;
}

.large-stars {
  gap: 12px;
}

.star.large {
  font-size: 40px;
}

.star.small {
  font-size: 24px;
}

/* Dimension */
.dimension-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.dim-label {
  font-size: 14px;
  color: var(--text);
  font-weight: 500;
}

/* Submit Section */
.submit-section {
  margin-top: 30px;
  text-align: center;
}

.submit-btn {
  width: 80%;
  height: 48px;
  background: var(--blue);
  color: var(--surface);
  font-size: 16px;
  font-weight: 500;
  border-radius: 24px;
  border: none;
  line-height: 48px;
}

.submit-btn.disabled {
  background: var(--text-quaternary);
}

.submit-note {
  display: block;
  margin-top: 12px;
  font-size: 12px;
  color: var(--text-tertiary);
}
