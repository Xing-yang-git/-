.container {
  padding: 32rpx;
  background: var(--bg);
  min-height: 100vh;
}

/* 头部 */
.rating-header {
  text-align: center;
  padding: 60rpx 0 40rpx;
}

.header-text {
  font-size: 40rpx;
  font-weight: 600;
  color: var(--text);
  display: block;
}

.header-type {
  font-size: 26rpx;
  color: var(--text-tertiary);
  margin-top: 12rpx;
  display: block;
}

/* 卡片标题覆盖 */
.card-title {
  text-align: center;
}

/* 星星行 */
.star-row {
  display: flex;
  justify-content: center;
  gap: 16rpx;
}

.large-stars {
  gap: 24rpx;
}

.star.large {
  font-size: 80rpx;
}

.star.small {
  font-size: 48rpx;
}

/* 评分维度 */
.dimension-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.dim-label {
  font-size: 28rpx;
  color: var(--text);
  font-weight: 500;
}

/* 提交区域 */
.submit-section {
  margin-top: 60rpx;
  text-align: center;
}

.submit-btn {
  width: 80%;
  height: 96rpx;
  background: var(--blue);
  color: var(--surface);
  font-size: 32rpx;
  font-weight: 500;
  border-radius: 48rpx;
  border: none;
  line-height: 96rpx;
}

.submit-btn.disabled {
  background: var(--text-quaternary);
}

.submit-note {
  display: block;
  margin-top: 24rpx;
  font-size: 24rpx;
  color: var(--text-tertiary);
}
