<view class="container">
  <!-- 头部 -->
  <view class="rating-header">
    <text class="header-text">为 {{targetName}} 评分</text>
    <text class="header-type">{{ratingTypeText}}</text>
  </view>

  <!-- 总体评分 -->
  <view class="card">
    <view class="card-title">总体评分</view>
    <view class="star-row large-stars">
      <view
        wx:for="{{[1,2,3,4,5]}}"
        wx:key="*this"
        class="star large {{item <= overallScore ? 'filled' : ''}}"
        bindtap="onOverallTap"
        data-score="{{item}}"
      >★</view>
    </view>
  </view>

  <!-- 提交 -->
  <view class="submit-section">
    <button class="submit-btn {{overallScore > 0 ? '' : 'disabled'}}" bindtap="onSubmit" disabled="{{overallScore === 0}}">提交评分</button>
    <text class="submit-note">评分提交后不可修改</text>
  </view>
</view>
