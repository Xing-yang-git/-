.detail-page {
  min-height: 100vh;
  display: flex;
  flex-direction: column;
  background: var(--bg);
}

.page-content {
  flex: 1;
  background: var(--bg);
}

.section-ios {
  padding: 16px;
  background: var(--surface);
  margin-bottom: 8px;
}

.detail-title {
  font-size: 22px;
  font-weight: 700;
  color: var(--text);
  line-height: 1.3;
  margin-bottom: 8px;
  letter-spacing: 0.01em;
}

.urgent-badge {
  display: inline-block;
  background: var(--red);
  color: var(--surface);
  font-size: 12px;
  padding: 2px 6px;
  border-radius: 4px;
  margin-right: 6px;
  vertical-align: middle;
}

.detail-desc {
  font-size: 15px;
  color: var(--text-secondary);
  line-height: 1.55;
}

.detail-tags {
  display: flex;
  gap: 8px;
  margin-top: 12px;
  flex-wrap: wrap;
}


.pub-header {
  display: flex;
  align-items: center;
  gap: 12px;
}


.pub-info {
  flex: 1;
}

.pub-name {
  font-size: 15px;
  font-weight: 500;
  color: var(--text);
}

.pub-meta {
  font-size: 12px;
  color: var(--text-secondary);
  margin-top: 2px;
}

.link-text {
  font-size: 14px;
  color: var(--blue);
}

.section-header-text {
  font-size: 15px;
  font-weight: 500;
  color: var(--text);
  margin-bottom: 10px;
}

.application-row {
  display: flex;
  justify-content: space-between;
  padding: 8px 0;
  border-bottom: 0.5px solid var(--bg);
}

.application-row:last-child {
  border-bottom: none;
}

.app-name {
  font-size: 14px;
  color: var(--text);
}

.app-time {
  font-size: 12px;
  color: var(--text-tertiary);
}


.action-btn {
  flex: 1;
  height: 44px;
  border-radius: 10px;
  font-size: 16px;
  font-weight: 600;
  display: flex;
  align-items: center;
  justify-content: center;
  border: none;
  line-height: 44px;
}

.action-btn::after {
  border: none;
}

.action-btn-primary {
  background: var(--blue);
  color: var(--surface);
}

.action-btn-outline {
  background: var(--surface);
  color: var(--blue);
  border: 1.5px solid var(--blue);
}


