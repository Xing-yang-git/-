/* ===== 求助详情页 — 仿 idle-detail 布局骨架 ===== */

.detail-page {
  min-height: 100vh;
  display: flex;
  flex-direction: column;
  background: var(--bg);
}

/* 状态横幅 */
.status-banner {
  padding: 10px 16px;
  text-align: center;
  font-size: 14px;
  color: var(--orange);
  background: rgba(255, 149, 0, 0.08);
}

/* 顶部图片轮播 — override 全局 .img-carousel，对齐 idle-detail（280px） */
swiper {
  width: 100%;
  height: 280px;
}

.carousel-image {
  width: 100%;
  height: 280px;
}

.page-content {
  flex: 1;
  background: var(--bg);
  padding-bottom: 100px;
}

.section-ios {
  padding: 16px;
  background: var(--surface);
  margin-bottom: 8px;
}

.section-ios .callout {
  margin: 12px 0 0;
}

.detail-title {
  font-size: 22px;
  font-weight: 700;
  color: var(--text);
  line-height: 1.3;
  margin-bottom: 8px;
  letter-spacing: 0.01em;
}

/* 紧急标签（help 特有） */
.urgent-badge {
  display: inline-block;
  background: var(--red);
  color: var(--surface);
  font-size: 12px;
  padding: 2px 6px;
  border-radius: 4px;
  margin-right: 6px;
  vertical-align: middle;
}

.detail-desc {
  font-size: 17px;           /* 原 15px → 17px（对齐 idle-detail） */
  color: var(--text-secondary);
  line-height: 1.55;
}

.detail-tags {
  display: flex;
  gap: 8px;
  margin-top: 12px;
  flex-wrap: wrap;
}

/* 发布者 */
.pub-header {
  display: flex;
  align-items: center;
  gap: 12px;
}

.pub-header .avatar {
  background: var(--fill-tertiary);
}

.pub-info {
  flex: 1;
}

.pub-name {
  font-size: 17px;           /* 原 15px → 17px */
  font-weight: 500;
  color: var(--text);
}

.pub-meta {
  font-size: 13px;           /* 原 12px → 13px */
  color: var(--text-secondary);
  margin-top: 2px;
}

.link-text {
  font-size: 13px;
  color: var(--blue);
}

/* 已有N位邻居愿意帮忙 */
.section-header-text {
  font-size: 15px;
  font-weight: 500;
  color: var(--text);
  margin-bottom: 10px;
}

/* ===== 固定底部操作栏（仿 idle-detail action-bar） ===== */
.action-bar {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  z-index: 100;
  background: var(--surface);
  display: flex;
  gap: 12px;
  padding: 12px 16px;
  padding-bottom: calc(var(--safe-bottom));
}

.action-btn {
  flex: 1;
  height: 44px;
  border-radius: 8px;
  font-size: 17px;
  font-weight: 500;
  display: flex;
  align-items: center;
  justify-content: center;
  border: none;
  line-height: 44px;
  padding: 0 20px;
  letter-spacing: -0.01em;
}

.action-btn::after {
  border: none;
}

.action-btn-primary {
  background: var(--blue);
  color: #FFFFFF;
}

.action-btn-primary[disabled] {
  opacity: 0.35;
}

.action-btn-secondary {
  background: var(--fill-tertiary);
  color: var(--text);
}

/* ===== Borrow summary（确认帮助弹层上方摘要） ===== */
.borrow-summary {
  padding: 16rpx 0 0;
}

.borrow-summary-row {
  display: flex;
  align-items: baseline;
  padding: 6rpx 0;
}

.borrow-summary-label {
  width: 140rpx;
  flex-shrink: 0;
  font-size: var(--text-sm);
  color: var(--text-secondary);
}

.borrow-summary-value {
  flex: 1;
  font-size: var(--text-sm);
  color: var(--text);
}

/* ===== Input / Textarea（确认帮助弹层内） ===== */
.input-group {
  margin-bottom: var(--space-4);
}

.input-label {
  display: block;
  font-size: var(--text-sm);
  color: var(--text-secondary);
  margin-bottom: 6px;
  letter-spacing: -0.01em;
}

.textarea {
  width: 100%;
  min-height: 100px;
  padding: 10px 12px;
  border: none;
  border-radius: var(--radius-sm);
  font-size: var(--text-base);
  background: var(--fill-tertiary);
}

/* ===== Borrow Sheet（确认帮助弹层） ===== */
.borrow-sheet {
  height: 80vh;
  display: flex;
  flex-direction: column;
  overflow: hidden;
}

.borrow-sheet-body {
  flex: 1;
  min-height: 0;
  padding: 0 20px;
  box-sizing: border-box;
}

.borrow-sheet-footer {
  flex-shrink: 0;
  display: flex;
  gap: 12px;
  padding: 12px 16px;
  padding-bottom: calc(var(--safe-bottom));
  background: var(--surface);
}

/* ===== History Sheet（以往记录弹层） ===== */
.history-sheet-overlay {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.3);
  z-index: 1000;
  animation: fadeIn var(--motion-base) var(--ease);
}

.history-sheet {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  max-height: 80vh;
  display: flex;
  flex-direction: column;
  overflow: hidden;
  background: var(--surface);
  border-radius: var(--radius-lg) var(--radius-lg) 0 0;
  animation: slideUp var(--motion-base) var(--ease-out);
  z-index: 1001;
}

.history-sheet-header {
  flex-shrink: 0;
  background: var(--surface);
  border-radius: var(--radius-lg) var(--radius-lg) 0 0;
}

.history-sheet-handle {
  width: 72rpx;
  height: 10rpx;
  border-radius: 6rpx;
  background: var(--fill-primary);
  margin: 16rpx auto 0;
}

.history-sheet-title {
  font-size: var(--text-base);
  font-weight: 600;
  text-align: center;
  padding: 24rpx 0;
  color: var(--text);
}

.history-sheet-body {
  flex: 1;
  min-height: 0;
  padding: 0 var(--margin);
}

.history-section {
  margin-bottom: var(--space-6);
}

.history-section-label {
  display: block;
  font-size: var(--text-xs);
  color: var(--text-secondary);
  margin-bottom: 12rpx;
  letter-spacing: 0.02em;
}

.history-resident-card {
  background: var(--fill-quaternary);
  border-radius: var(--radius);
  padding: 24rpx;
}

.history-resident-row {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
}

.history-resident-addr {
  font-size: var(--text-sm);
  color: var(--text);
}

.history-rating-inline {
  display: flex;
  align-items: baseline;
  gap: 20rpx;
  flex-shrink: 0;
}

.history-rating-score-row {
  display: flex;
  align-items: baseline;
  gap: 4rpx;
}

.history-rating-label {
  font-size: var(--text-xs);
  color: var(--text-secondary);
}

.history-rating-value {
  font-size: var(--text-xl);
  font-weight: 600;
  color: var(--orange);
}

.history-rating-unit {
  font-size: var(--text-xs);
  color: var(--text-secondary);
}

.history-stats-grid {
  display: flex;
  flex-wrap: wrap;
  background: var(--fill-quaternary);
  border-radius: var(--radius);
  padding: 24rpx 16rpx;
}

.history-stat-item {
  width: 33.33%;
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 16rpx 0;
}

.history-stat-half {
  width: 50%;
}

.history-stat-value {
  font-size: var(--text-base);
  font-weight: 600;
  color: var(--text);
}

.history-stat-label {
  font-size: var(--text-xs);
  color: var(--text-secondary);
  margin-top: 4rpx;
}
