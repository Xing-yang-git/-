.home-page {
  min-height: 100vh;
  background: var(--bg);
  display: flex;
  flex-direction: column;
}

/* 固定头部 — 从屏幕顶部全宽覆盖；通过 JS 设置 padding-top 将内容推到导航栏下方 */
.home-top-fixed {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  z-index: 100;
  background: rgba(255, 255, 255);
}

.home-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 40rpx 32rpx 12rpx;
  gap: 24rpx;
}

.community-name {
  font-size: 56rpx;
  font-weight: 700;
  color: var(--text);
  letter-spacing: 0.01em;
  line-height: 1.2;
  flex-shrink: 1;
  min-width: 0;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.search-box {
  display: flex;
  align-items: center;
  justify-content: space-between;
  width: 40%;
  min-width: 240rpx;
  flex-shrink: 0;
  height: 68rpx;
  padding: 0 20rpx 0 28rpx;
  background: var(--fill-tertiary, var(--fill-tertiary));
  border-radius: 34rpx;
}

.search-placeholder {
  font-size: 28rpx;
  color: var(--text-secondary, var(--text-tertiary));
  flex-shrink: 0;
}

.search-box-icon {
  width: 36rpx;
  height: 36rpx;
  flex-shrink: 0;
  opacity: 0.5;
}

.segment-wrap {
  background: var(--surface);
  padding: 16rpx 32rpx;
}

.segment {
  display: flex;
  background: var(--bg);
  border-radius: 16rpx;
  padding: 4rpx;
}

.segment-item {
  flex: 1;
  text-align: center;
  padding: 12rpx 0;
  font-size: 26rpx;
  font-weight: 500;
  color: var(--text-secondary);
  border-radius: 14rpx;
  transition: all var(--motion-fast) var(--ease);
}

.segment-item.active {
  background: var(--surface);
  color: var(--text);
  box-shadow: var(--shadow-sm);
}

/* flex: 1 使列表区域填充剩余视口高度，即使为空时也不塌缩到内容高度
   （与 B 端 .unified-panel 相同模式） */
.list-area {
  flex: 1;
  background: var(--surface);
}

.list-card {
  display: flex;
  padding: 24rpx 32rpx;
  background: var(--surface);
  gap: 24rpx;
  align-items: center;
}

.list-card:active {
  background: var(--fill-quaternary);
}

/* 渐变极细分割线（两端淡出），对齐消息页分隔线样式 */
.list-card + .list-card {
  background-image: linear-gradient(to right, transparent 8%, var(--separator) 25%, var(--separator) 75%, transparent 92%);
  background-repeat: no-repeat;
  background-size: 100% 0.5px;
  background-position: top;
}

.thumb {
  width: 128rpx;
  height: 128rpx;
  border-radius: 16rpx;
  background: var(--fill-tertiary);
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.thumb-icon {
  width: 56rpx;
  height: 56rpx;
}

.info {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
  gap: 6rpx;
}

.card-title {
  font-size: 26rpx;
  font-weight: 400;
  color: var(--text);
  line-height: 1.3;
  display: -webkit-box;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
  overflow: hidden;
}

.card-meta {
  font-size: 24rpx;
  color: var(--text-secondary);
}

.tags {
  display: flex;
  gap: 12rpx;
  margin-top: 4rpx;
}

/* 标签覆盖 */
.urgent-tag {
  margin-right: 8rpx;
}

.tag-gray {
  background: var(--fill-tertiary);
  color: var(--text-secondary);
}

/* FAB */
.fab {
  position: fixed;
  bottom: 240rpx;
  right: 32rpx;
  width: 100rpx;
  height: 100rpx;
  border-radius: 50rpx;
  background: var(--blue);
  box-shadow: 0 12rpx 36rpx rgba(0, 113, 227, 0.35);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 100;
}

.fab:active {
  transform: scale(0.92);
}

.fab-icon-img {
  width: 44rpx;
  height: 44rpx;
  transition: transform 150ms var(--ease);
}

.fab-icon-img.rotate {
  transform: rotate(45deg);
}

.fab-menu-icon {
  width: 36rpx;
  height: 36rpx;
  flex-shrink: 0;
}

/* 空状态 — 屏幕垂直居中 */
.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding-top: 35vh;
}

/* 空状态图片图标 */
.empty-icon-img {
  width: 80rpx;
  height: 80rpx;
  opacity: 0.6;
  margin-bottom: 24rpx;
}

.empty-text {
  font-size: 30rpx;
  color: var(--text-secondary);
  text-align: center;
}

.fab-overlay {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.15);
  z-index: 99;
}

.fab-menu {
  position: fixed;
  bottom: 360rpx;
  right: 32rpx;
  z-index: 101;
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.fab-menu-item {
  display: flex;
  align-items: center;
  gap: 16rpx;
  background: rgba(44, 44, 46, 0.9);
  border-radius: 40rpx;
  padding: 20rpx 32rpx;
  color: var(--surface);
  font-size: 26rpx;
  white-space: nowrap;
}
