.home-page {
  min-height: 100vh;
  background: var(--bg);
  display: flex;
  flex-direction: column;
}

/* 固定头部 — 从屏幕顶部全宽覆盖；通过 JS 设置 padding-top 将内容推到导航栏下方 */
.home-top-fixed {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  z-index: 100;
  background: rgba(255, 255, 255);
  backdrop-filter: blur(20px);
  -webkit-backdrop-filter: blur(20px);
}

.home-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 20px 16px 6px;
  gap: 12px;
}

.community-name {
  font-size: 28px;
  font-weight: 700;
  color: var(--text);
  letter-spacing: 0.01em;
  line-height: 1.2;
  flex-shrink: 1;
  min-width: 0;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.search-box {
  display: flex;
  align-items: center;
  justify-content: space-between;
  width: 40%;
  min-width: 120px;
  flex-shrink: 0;
  height: 34px;
  padding: 0 10px 0 14px;
  background: var(--fill-tertiary, #F2F2F7);
  border-radius: 17px;
}

.search-placeholder {
  font-size: 14px;
  color: var(--text-secondary, #8E8E93);
  flex-shrink: 0;
}

.search-box-icon {
  width: 18px;
  height: 18px;
  flex-shrink: 0;
  opacity: 0.5;
}

.segment-wrap {
  background: var(--surface);
  padding: 8px 16px;
}

.segment {
  display: flex;
  background: var(--bg);
  border-radius: 8px;
  padding: 2px;
}

.segment-item {
  flex: 1;
  text-align: center;
  padding: 6px 0;
  font-size: 13px;
  font-weight: 500;
  color: var(--text-secondary);
  border-radius: 7px;
  transition: all var(--motion-fast) var(--ease);
}

.segment-item.active {
  background: var(--surface);
  color: var(--text);
  box-shadow: var(--shadow-sm);
}

/* flex: 1 使列表区域填充剩余视口高度，即使为空时也不塌缩到内容高度
   （与 B 端 .unified-panel 相同模式） */
.list-area {
  flex: 1;
  background: var(--surface);
}

.list-card {
  display: flex;
  padding: 12px 16px;
  background: var(--surface);
  gap: 12px;
  align-items: center;
}

.list-card:active {
  background: var(--fill-quaternary);
}

/* 渐变极细分割线（两端淡出），对齐消息页分隔线样式 */
.list-card + .list-card {
  background-image: linear-gradient(to right, transparent 8%, var(--separator) 25%, var(--separator) 75%, transparent 92%);
  background-repeat: no-repeat;
  background-size: 100% 0.5px;
  background-position: top;
}

.thumb {
  width: 64px;
  height: 64px;
  border-radius: 8px;
  background: var(--fill-tertiary);
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.thumb-icon {
  width: 28px;
  height: 28px;
}

.info {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
  gap: 3px;
}

.card-title {
  font-size: 13px;
  font-weight: 400;
  color: var(--text);
  line-height: 1.3;
  display: -webkit-box;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
  overflow: hidden;
}

.card-meta {
  font-size: 12px;
  color: var(--text-secondary);
}

.tags {
  display: flex;
  gap: 6px;
  margin-top: 2px;
}

/* 标签覆盖 */
.urgent-tag {
  margin-right: 4px;
}

.tag-gray {
  background: var(--fill-tertiary);
  color: var(--text-secondary);
}

/* FAB */
.fab {
  position: fixed;
  bottom: 120px;
  right: 16px;
  width: 50px;
  height: 50px;
  border-radius: 25px;
  background: var(--blue);
  box-shadow: 0 6px 18px rgba(0, 113, 227, 0.35);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 100;
}

.fab:active {
  transform: scale(0.92);
}

.fab-icon-img {
  width: 22px;
  height: 22px;
  transition: transform 150ms var(--ease);
}

.fab-icon-img.rotate {
  transform: rotate(45deg);
}

.fab-menu-icon {
  width: 18px;
  height: 18px;
  flex-shrink: 0;
}

/* 空状态 — 屏幕垂直居中 */
.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding-top: 35vh;
}

/* 空状态图片图标 */
.empty-icon-img {
  width: 40px;
  height: 40px;
  opacity: 0.6;
  margin-bottom: 12px;
}

.empty-text {
  font-size: 15px;
  color: var(--text-secondary);
  text-align: center;
}

.fab-overlay {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.15);
  z-index: 99;
}

.fab-menu {
  position: fixed;
  bottom: 180px;
  right: 16px;
  z-index: 101;
  display: flex;
  flex-direction: column;
  gap: 8px;
}

.fab-menu-item {
  display: flex;
  align-items: center;
  gap: 8px;
  background: rgba(44, 44, 46, 0.9);
  border-radius: 20px;
  padding: 10px 16px;
  color: #FFFFFF;
  font-size: 13px;
  white-space: nowrap;
}
