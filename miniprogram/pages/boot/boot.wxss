/* Boot 启动页 — 冷启动会话恢复中转，仅展示启动画面（复用登录页品牌视觉，不另造样式） */
.boot-page {
  min-height: 100vh;
  background: var(--bg);
  display: flex;
  align-items: center;
  justify-content: center;
}

.boot-brand {
  display: flex;
  flex-direction: column;
  align-items: center;
}

.boot-icon-area {
  margin-bottom: 48rpx;
}

.boot-icon {
  width: 160rpx;
  height: 160rpx;
  border-radius: 40rpx;
  background: var(--blue);
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 16rpx 48rpx rgba(0, 113, 227, 0.25);
}

.boot-icon-img {
  width: 80rpx;
  height: 80rpx;
}

.boot-title {
  font-size: var(--text-2xl);
  font-weight: 700;
  color: var(--text);
}

.boot-sub {
  margin-top: 16rpx;
  font-size: var(--text-sm);
  color: var(--text-tertiary);
}
