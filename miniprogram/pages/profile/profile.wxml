<!--
  profile 个人主页 — 像素级对齐原型 profile.html
  原型路径: c-end/pages/profile.html
-->
<view class="container">

  <!-- 导航栏 -->
  <view class="nav-wrap" style="padding-top: {{statusBarHeight}}px;">
    <view class="nav-bar"></view>
  </view>

  <view class="page-content">

    <!-- 加载状态 -->
    <view class="global-loading" wx:if="{{loading}}">
      <view class="loading-spinner"></view>
      <text class="loading-text">加载中...</text>
    </view>

    <!-- 个人资料卡片 -->
    <view class="profile-card" wx:if="{{!loading}}">
      <view class="avatar">👤</view>
      <view class="info">
        <view class="name-row">
          <view class="name">{{roomInfo}}</view>
          <view class="logout-icon" bindtap="onLogoutTap">
            <image class="logout-icon-img" src="../../images/logout-icon.svg" mode="aspectFit" />
          </view>
        </view>
        <view class="meta">
          <view class="auth-tag {{isAuth ? 'authed' : 'unauthed'}}">{{isAuth ? '已认证' : '未认证'}}</view>
          <text>{{userTypeText}}</text>
        </view>
        <view class="rate">综合评分 {{score}} / 5.0 · {{ratingCount}} 人评价</view>
      </view>
    </view>

    <!-- 统计网格 -->
    <view class="profile-stats-grid" wx:if="{{!loading}}">
      <view class="profile-stat-item">
        <text class="profile-stat-value">{{borrowCount}}</text>
        <text class="profile-stat-label">借入次数</text>
      </view>
      <view class="profile-stat-item">
        <text class="profile-stat-value">{{borrowReturnRate}}%</text>
        <text class="profile-stat-label">按时归还率</text>
      </view>
      <view class="profile-stat-item">
        <text class="profile-stat-value">{{lendCount}}</text>
        <text class="profile-stat-label">借出次数</text>
      </view>
      <view class="profile-stat-item">
        <text class="profile-stat-value">{{helpReqCount}}</text>
        <text class="profile-stat-label">求助次数</text>
      </view>
      <view class="profile-stat-item">
        <text class="profile-stat-value">{{helpProCount}}</text>
        <text class="profile-stat-label">帮助他人</text>
      </view>
    </view>

    <!-- 记录标签 -->
    <view class="record-header">
      <view class="segment">
        <view class="segment-item {{recordTab === 'idle' ? 'active' : ''}}" bindtap="onRecordTabTap" data-tab="idle">互借记录</view>
        <view class="segment-item {{recordTab === 'help' ? 'active' : ''}}" bindtap="onRecordTabTap" data-tab="help">互助记录</view>
      </view>
    </view>

    <!-- 互借记录 -->
    <view class="record-list" wx:if="{{recordTab === 'idle'}}">
      <block wx:for="{{idleRecords}}" wx:key="id">
        <view class="list-row" bindtap="onOpenRecord" data-record="{{item}}">
          <view class="list-bd">
            <view class="list-title">{{item.title}}</view>
            <view class="list-desc">{{item.roleText}}：{{item.peerName}} · {{item.dateText}}</view>
          </view>
          <view class="list-ft">
            <view class="record-tag {{item.type === 'LEND' ? 'lend' : 'borrow'}}">{{item.typeText}}</view>
          </view>
        </view>
      </block>
      <view class="empty-state" wx:if="{{idleRecords.length === 0}}">
        <text class="empty-text">暂无互借记录</text>
      </view>
      <view class="list-end" wx:if="{{idleRecords.length > 0}}">— 共 {{idleRecords.length}} 条记录 —</view>
    </view>

    <!-- 互助记录 -->
    <view class="record-list" wx:if="{{recordTab === 'help'}}">
      <block wx:for="{{helpRecords}}" wx:key="id">
        <view class="list-row" bindtap="onOpenRecord" data-record="{{item}}">
          <view class="list-bd">
            <view class="list-title">{{item.title}}</view>
            <view class="list-desc">{{item.roleText}}：{{item.peerName}} · {{item.dateText}}</view>
          </view>
          <view class="list-ft">
            <view class="record-tag {{item.type === 'HELP' ? 'help' : 'seek'}}">{{item.typeText}}</view>
          </view>
        </view>
      </block>
      <view class="empty-state" wx:if="{{helpRecords.length === 0}}">
        <text class="empty-text">暂无互助记录</text>
      </view>
      <view class="list-end" wx:if="{{helpRecords.length > 0}}">— 共 {{helpRecords.length}} 条记录 —</view>
    </view>

  </view>

</view>

<!-- 退出登录确认弹窗 -->
<view class="alert-overlay" wx:if="{{showLogoutAlert}}" catchtap="onCloseLogoutAlert">
  <view class="alert" catchtap="">
    <view class="alert-title">退出登录</view>
    <view class="alert-body">确定要退出当前账户吗？</view>
    <view class="alert-actions">
      <view class="alert-btn" bindtap="onCancelLogout">取消</view>
      <view class="alert-btn alert-btn-bold alert-btn-danger" bindtap="onDoLogout">确认退出</view>
    </view>
  </view>
</view>

<!-- 记录详情弹窗 -->
<view class="alert-overlay" wx:if="{{showRecordDetail}}" catchtap="onCloseRecordDetail">
  <view class="alert" catchtap="">
    <view class="alert-title">互助记录详情</view>
    <view class="alert-body">
      <view class="info-row">
        <text class="info-label">物品/事项</text>
        <text class="info-value">{{recordDetail.item}}</text>
      </view>
      <view class="info-row">
        <text class="info-label">我的角色</text>
        <text class="info-value">{{recordDetail.role}}</text>
      </view>
      <view class="info-row">
        <text class="info-label">对方</text>
        <text class="info-value">{{recordDetail.peer}}</text>
      </view>
      <view class="info-row">
        <text class="info-label">日期</text>
        <text class="info-value">{{recordDetail.date}}</text>
      </view>
      <view class="info-row">
        <text class="info-label">评价</text>
        <text class="info-value">{{recordDetail.remark}}</text>
      </view>
    </view>
    <view class="alert-actions">
      <view class="alert-btn alert-btn-bold" bindtap="onCloseRecordDetail">关闭</view>
    </view>
  </view>
</view>
