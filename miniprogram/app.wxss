/* ============================================================
   社区互助闲置平台 · 全局样式
   设计参考: iOS UI — Apple UI Designer 设计系统
   设计哲学: Native, Subtle, Calm, Human
   ============================================================ */

/* --- 设计令牌（CSS 变量） --- */
page {
  --blue: #0071e3;
  --blue-hover: #0077ed;
  --bg: #f5f5f7;
  --bg-elevated: #FFFFFF;
  --surface: #FFFFFF;
  --surface-grouped: #f5f5f7;

  --text: #1D1D1F;
  --text-secondary: #6E6E73;
  --text-tertiary: #86868B;
  --text-quaternary: rgba(60, 60, 67, 0.18);

  --separator: #D2D2D7;
  --separator-opaque: #E8E8ED;

  --red: #FF3B30;
  --orange: #FF9500;
  --green: #34C759;
  --teal: #5AC8FA;
  --indigo: #5856D6;

  --dark-surface: #1C1C1E;           /* 深色表面（图片轮播背景） */
  --text-quaternary-solid: #AEAEB2;  /* 第四级文字色（实色版） */
  --green-bg: #E8F8E8;              /* 绿色浅底（状态标签） */
  --orange-bg: #FFF8E8;             /* 橙色浅底（状态标签） */
  --red-bg: #FFE8E8;                /* 红色浅底（状态标签） */

  --fill-primary: rgba(120, 120, 128, 0.2);
  --fill-secondary: rgba(120, 120, 128, 0.16);
  --fill-tertiary: rgba(120, 120, 128, 0.12);
  --fill-quaternary: rgba(120, 120, 128, 0.08);

  --font: -apple-system, BlinkMacSystemFont, "SF Pro Display", "SF Pro Text", "Helvetica Neue", "PingFang SC", sans-serif;

  --text-xs: 12px;
  --text-sm: 13px;
  --text-md: 15px;
  --text-base: 17px;
  --text-lg: 20px;
  --text-xl: 22px;
  --text-2xl: 28px;
  --text-3xl: 34px;

  --space-1: 4px;
  --space-2: 8px;
  --space-3: 12px;
  --space-4: 16px;
  --space-5: 20px;
  --space-6: 24px;
  --space-8: 32px;
  --space-12: 48px;

  --radius-sm: 6px;
  --radius: 10px;
  --radius-md: 12px;
  --radius-lg: 14px;
  --radius-xl: 20px;
  --radius-pill: 9999px;

  --shadow-sm: 0 1px 3px rgba(0, 0, 0, 0.06);
  --shadow: 0 1px 4px rgba(0, 0, 0, 0.08);
  --shadow-md: 0 4px 12px rgba(0, 0, 0, 0.1);
  --shadow-lg: 0 8px 24px rgba(0, 0, 0, 0.12);

  --ease: cubic-bezier(0.28, 0, 0.22, 1);
  --ease-in: cubic-bezier(0.42, 0, 1, 1);
  --ease-out: cubic-bezier(0, 0, 0.58, 1);
  --motion-fast: 150ms;
  --motion-base: 250ms;
  --motion-slow: 350ms;

  --nav-height: 44px;
  --tab-height: 50px;
  --status-height: 28px;
  --safe-bottom: 34px;
  --margin: 16px;

  --font-mono: "SF Mono", Menlo, "Courier New", monospace;

  box-sizing: border-box;
  font-family: var(--font);
  font-size: var(--text-base);
  color: var(--text);
  background: var(--bg);
  line-height: 1.45;
}

/* --- 全局关键帧动画 --- */
@keyframes fadeIn { from { opacity: 0; } to { opacity: 1; } }
@keyframes scaleIn { from { opacity: 0; transform: scale(0.95); } to { opacity: 1; transform: scale(1); } }
@keyframes slideUp { from { transform: translateY(100%); } to { transform: translateY(0); } }
@keyframes toastIn { from { opacity: 0; transform: scale(0.9); } to { opacity: 1; transform: scale(1); } }
@keyframes voicePlayBar { from { transform: scaleY(0.5); } to { transform: scaleY(1.3); } }
@keyframes spin { to { transform: rotate(360deg); } }
@keyframes slideDown { from { transform: translateY(-100%); } to { transform: translateY(0); } }

/* --- 重置 --- */
view, text, image, scroll-view, swiper, swiper-item, button, input, textarea, navigator,
icon, picker, form, label, checkbox, radio, slider, switch, progress, rich-text,
video, audio, map, canvas, cover-view, cover-image, movable-view, movable-area,
view::before, view::after, text::before, text::after, button::before, button::after,
input::before, input::after, textarea::before, textarea::after {
  box-sizing: border-box;
  margin: 0;
  padding: 0;
}

button {
  border: none;
  background: none;
  font: inherit;
  color: inherit;
}
button::after {
  border: none;
}

input, textarea {
  font: inherit;
  outline: none;
}

image {
  max-width: 100%;
  display: block;
}

/* --- 页面容器 --- */
.page {
  padding: var(--space-4);
  min-height: 100vh;
  background: var(--bg);
}
.page-no-padding {
  min-height: 100vh;
  background: var(--bg);
}

/* --- Card（iOS 风格 — 无边框，微阴影） --- */
.card {
  background: var(--surface);
  border-radius: var(--radius);
  margin: 0 0 20rpx;
  overflow: hidden;
  box-shadow: var(--shadow-sm);
}
.card-body {
  padding: var(--space-4);
}
.card-header {
  padding: 24rpx var(--space-4);
  display: flex;
  align-items: center;
  gap: 20rpx;
}
.card-footer {
  padding: 20rpx var(--space-4);
  display: flex;
  justify-content: space-between;
  align-items: center;
  font-size: var(--text-sm);
  color: var(--text-secondary);
}

/* 横向卡片（带缩略图列表项） */
.card-h {
  display: flex;
  padding: 24rpx var(--space-4);
  background: var(--surface);
  gap: 24rpx;
  align-items: center;
}
.card-h:active {
  background: var(--fill-quaternary);
}
.card-h + .card-h {
  border-top: none;
}
.card-h-img {
  width: 144rpx;
  height: 144rpx;
  border-radius: 16rpx;
  background: var(--fill-tertiary);
  flex-shrink: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 64rpx;
  overflow: hidden;
}
.card-h-body {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
  justify-content: center;
  gap: 8rpx;
}
.card-h-title {
  font-size: var(--text-base);
  font-weight: 500;
  overflow: hidden;
  text-overflow: ellipsis;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  line-height: 1.3;
}
.card-h-meta {
  display: flex;
  justify-content: space-between;
  align-items: center;
  font-size: var(--text-sm);
  color: var(--text-secondary);
}

/* --- 导航栏 --- */
.nav-bar-placeholder {
  height: var(--nav-height);
}

/* --- 底部弹出层 --- */
.sheet-overlay {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.3);
  z-index: 1000;
  animation: fadeIn var(--motion-base) var(--ease);
}
.sheet {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  max-height: 80vh;
  overflow-y: auto;
  background: var(--surface);
  border-radius: var(--radius-lg) var(--radius-lg) 0 0;
  z-index: 1001;
  animation: slideUp 0.3s var(--ease-out);
}
.sheet-handle {
  width: 72rpx;
  height: 10rpx;
  border-radius: 6rpx;
  background: var(--fill-primary);
  margin: 16rpx auto 0;
}
.sheet-header {
  padding: 32rpx 40rpx 24rpx;
  text-align: center;
  font-size: var(--text-base);
  font-weight: 600;
}
.sheet-body {
  padding: 0 40rpx 40rpx;
}

/* --- 按钮 --- */
.btn {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  height: 88rpx;
  padding: 0 40rpx;
  border-radius: 16rpx;
  font-size: var(--text-base);
  font-weight: 500;
  transition: all var(--motion-fast) var(--ease);
  gap: 8rpx;
  letter-spacing: -0.01em;
}
.btn:active {
  transform: scale(0.97);
  opacity: 0.85;
}
.btn-block {
  display: flex;
  width: 100%;
}
.btn-primary {
  background: var(--blue);
  color: var(--surface);
}
.btn-secondary {
  background: var(--fill-tertiary);
  color: var(--text);
}
.btn-danger {
  background: var(--red);
  color: var(--surface);
}
.btn-ghost {
  background: transparent;
  color: var(--blue);
}
.btn-sm {
  height: 64rpx;
  padding: 0 24rpx;
  font-size: var(--text-sm);
  border-radius: 12rpx;
}
.btn-lg {
  height: 100rpx;
  font-size: var(--text-base);
}
.btn-disabled {
  opacity: 0.35;
  pointer-events: none;
}

/* --- 徽标 --- */
.badge {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  min-width: 36rpx;
  height: 36rpx;
  border-radius: 18rpx;
  background: var(--red);
  color: var(--surface);
  font-size: 22rpx;
  font-weight: 600;
  padding: 0 10rpx;
}
.badge-dot {
  min-width: 16rpx;
  height: 16rpx;
  border-radius: 50%;
  padding: 0;
}
.badge-wrap {
  position: relative;
  display: inline-flex;
}

/* --- 标签 --- */
.tag {
  display: inline-flex;
  align-items: center;
  height: 40rpx;
  padding: 0 16rpx;
  border-radius: 8rpx;
  font-size: 22rpx;
  font-weight: 500;
}
.tag-fill {
  background: var(--fill-tertiary);
  color: var(--text-secondary);
}
.tag-blue {
  background: rgba(0, 113, 227, 0.1);
  color: var(--blue);
}
.tag-red {
  background: rgba(255, 59, 48, 0.1);
  color: var(--red);
}
.tag-orange {
  background: rgba(255, 149, 0, 0.1);
  color: var(--orange);
}
.tag-green {
  background: rgba(52, 199, 89, 0.1);
  color: var(--green);
}

/* --- 分割线 --- */
.divider {
  height: 0.5px;
  background: var(--separator);
}
.spacer-8 { height: 16rpx; }
.spacer-16 { height: 32rpx; }
.spacer-24 { height: 48rpx; }

/* --- 空状态 --- */
.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 120rpx 80rpx;
  text-align: center;
}
.empty-icon {
  width: 160rpx;
  height: 160rpx;
  margin-bottom: 32rpx;
  background: var(--fill-tertiary);
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 72rpx;
  opacity: 0.6;
}
.empty-text {
  font-size: var(--text-sm);
  color: var(--text-secondary);
  line-height: 1.5;
}

/* --- 表单元素 --- */
.form-group {
  margin-bottom: var(--space-4);
}
.form-label {
  display: block;
  font-size: var(--text-sm);
  color: var(--text-secondary);
  margin-bottom: 12rpx;
  letter-spacing: -0.01em;
}
.form-label .required {
  color: var(--red);
}
.form-input {
  width: 100%;
  height: 88rpx;
  padding: 0 24rpx;
  border: none;
  border-radius: var(--radius-sm);
  font-size: var(--text-base);
  background: var(--fill-tertiary);
}
.form-textarea {
  width: 100%;
  min-height: 200rpx;
  padding: 20rpx 24rpx;
  border: none;
  border-radius: var(--radius-sm);
  font-size: var(--text-base);
  background: var(--fill-tertiary);
}

/* --- 搜索栏 --- */
.search-bar {
  padding: 16rpx var(--space-4);
  background: var(--bg);
}
.search-input-wrap {
  display: flex;
  align-items: center;
  background: var(--fill-tertiary);
  border-radius: 20rpx;
  padding: 0 16rpx;
  height: 72rpx;
}
.search-input-wrap .search-icon {
  width: 40rpx;
  height: 40rpx;
  margin: 0 12rpx;
  flex-shrink: 0;
  opacity: 0.45;
}
.search-input-wrap input {
  flex: 1;
  border: none;
  background: transparent;
  font-size: var(--text-base);
  height: 100%;
}

/* --- 分段控制器 --- */
.segment {
  display: flex;
  background: var(--bg);
  border-radius: 16rpx;
  padding: 4rpx;
}
.segment-item {
  flex: 1;
  text-align: center;
  padding: 12rpx 0;
  font-size: var(--text-sm);
  font-weight: 500;
  color: var(--text-secondary);
  border-radius: 14rpx;
  transition: all var(--motion-fast) var(--ease);
}
.segment-item.active {
  background: var(--surface);
  color: var(--text);
  box-shadow: var(--shadow-sm);
}

/* --- 分类胶囊 --- */
.pill-row {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}
.pill {
  padding: 16rpx 32rpx;
  border-radius: var(--radius-pill);
  background: var(--fill-tertiary);
  font-size: var(--text-sm);
  color: var(--text);
  transition: all var(--motion-fast) var(--ease);
}
.pill.selected {
  background: var(--blue);
  color: var(--surface);
}

/* --- 头像 --- */
.avatar {
  width: 80rpx;
  height: 80rpx;
  border-radius: 50%;
  background: var(--fill-secondary);
  flex-shrink: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 32rpx;
  color: var(--text-tertiary);
  overflow: hidden;
}
.avatar-sm {
  width: 64rpx;
  height: 64rpx;
  font-size: 26rpx;
}
.avatar-lg {
  width: 120rpx;
  height: 120rpx;
  font-size: 44rpx;
}

/* --- 星级评分 --- */
.stars {
  display: inline-flex;
  gap: 12rpx;
}
.star {
  font-size: 64rpx;
  color: var(--fill-tertiary);
  transition: color var(--motion-fast) var(--ease), transform var(--motion-fast) var(--ease);
}
.star:active {
  transform: scale(1.2);
}
.star.active {
  color: var(--orange);
}

/* --- 排版 --- */
.text-caption {
  font-size: var(--text-xs);
  color: var(--text-tertiary);
}
.text-body {
  font-size: var(--text-base);
  color: var(--text);
}
.text-title {
  font-size: var(--text-lg);
  font-weight: 600;
  color: var(--text);
}
.text-secondary {
  color: var(--text-secondary);
}
.text-tertiary {
  color: var(--text-tertiary);
}
.text-blue {
  color: var(--blue);
}
.text-red {
  color: var(--red);
}
.text-center {
  text-align: center;
}

/* --- Flex 工具类 --- */
.flex {
  display: flex;
}
.flex-col {
  flex-direction: column;
}
.flex-between {
  justify-content: space-between;
}
.flex-center {
  align-items: center;
}
.flex-1 {
  flex: 1;
}
.gap-8 { gap: 16rpx; }
.gap-12 { gap: 24rpx; }
.gap-16 { gap: 32rpx; }

/* --- 聊天气泡 --- */
.chat-bubble {
  max-width: 75%;
  padding: 20rpx 28rpx;
  border-radius: 36rpx;
  font-size: var(--text-base);
  line-height: 1.4;
  word-break: break-all;
}
.chat-bubble-left {
  align-self: flex-start;
  background: var(--fill-tertiary);
  color: var(--text);
  border-bottom-left-radius: 8rpx;
}
.chat-bubble-right {
  align-self: flex-end;
  background: var(--blue);
  color: var(--surface);
  border-bottom-right-radius: 8rpx;
}
.chat-bubble-system {
  align-self: center;
  font-size: var(--text-xs);
  color: var(--text-secondary);
  background: var(--fill-quaternary);
  padding: 12rpx 24rpx;
  border-radius: 24rpx;
}

/* --- 操作栏（底部固定） --- */
.action-bar {
  display: flex;
  gap: 24rpx;
  padding: var(--space-4);
  padding-bottom: calc(var(--space-4) + var(--safe-bottom));
  background: rgba(255, 255, 255, 0.82);
}
.action-bar .btn {
  flex: 1;
}

/* --- 列表底部 --- */
.list-end {
  text-align: center;
  padding: 40rpx;
  font-size: var(--text-xs);
  color: var(--text-tertiary);
}

/* --- 极细边框行 --- */
.list-row {
  display: flex;
  align-items: center;
  padding: 24rpx var(--space-4);
  min-height: 88rpx;
  gap: 24rpx;
  background: var(--surface);
}
.list-row:active {
  background: var(--fill-quaternary);
}
.list-row + .list-row {
  border-top: 0.5px solid var(--separator);
}
.list-row .list-hd {
  flex-shrink: 0;
}
.list-row .list-bd {
  flex: 1;
  min-width: 0;
}
.list-row .list-ft {
  flex-shrink: 0;
  color: var(--text-tertiary);
  font-size: var(--text-base);
  display: flex;
  align-items: center;
  gap: 8rpx;
}
.list-row .list-title {
  font-size: var(--text-base);
  color: var(--text);
}
.list-row .list-desc {
  font-size: var(--text-sm);
  color: var(--text-secondary);
  margin-top: 4rpx;
  line-height: 1.3;
}

/* --- 极细分割线 --- */
.hairline { height: 0.5px; background: var(--separator); }

/* --- 列表箭头（展开指示器） --- */
.list-chevron::after {
  content: "›";
  font-size: 40rpx;
  color: var(--text-quaternary);
  margin-left: 8rpx;
}

/* --- 内嵌分组列表（iOS 13+） --- */
.inset-group {
  margin: var(--margin);
}
.inset-group-title {
  font-size: var(--text-sm);
  color: var(--text-secondary);
  text-transform: none;
  padding: 0 var(--margin) 12rpx;
  letter-spacing: -0.01em;
}
.inset-group .list-row:first-child { border-radius: var(--radius) var(--radius) 0 0; }
.inset-group .list-row:last-child { border-radius: 0 0 var(--radius) var(--radius); }
.inset-group .list-row:only-child { border-radius: var(--radius); }

/* --- 列表分组（分组表格容器） --- */
.list-group {
  margin: var(--margin);
  background: var(--surface);
  border-radius: 16rpx;
  overflow: hidden;
}

/* --- 信息行（键值对） --- */
.info-row {
  display: flex;
  justify-content: space-between;
  padding: 16rpx 0;
  font-size: var(--text-base);
}
.info-row .info-label { color: var(--text-secondary); }
.info-row .info-value { color: var(--text); text-align: right; }
.info-row .info-time-value { color: var(--text-secondary); font-size: var(--text-sm); }
.info-row .help-time-value { color: var(--text); font-size: var(--text-sm); text-align: right; }

/* --- 提示条 / 通知 --- */
.callout {
  margin: 0 var(--margin) 24rpx;
  padding: 28rpx 32rpx;
  background: rgba(255, 149, 0, 0.08);
  border-radius: var(--radius);
  font-size: var(--text-sm);
  color: var(--orange);
  line-height: 1.5;
}
.callout strong { font-weight: 600; }
.callout-red { background: rgba(255, 59, 48, 0.08); color: var(--red); }
.callout-blue { background: rgba(0, 113, 227, 0.06); color: var(--blue); }

/* --- 警告弹窗（iOS 居中模态框） --- */
.alert-overlay {
  position: fixed;
  top: 0; left: 0; right: 0; bottom: 0;
  background: rgba(0, 0, 0, 0.3);
  z-index: 1000;
  display: flex;
  align-items: center;
  justify-content: center;
  animation: fadeIn var(--motion-base) var(--ease);
}
.alert {
  width: 540rpx;
  background: var(--surface);
  border-radius: var(--radius-lg);
  animation: scaleIn var(--motion-base) var(--ease);
  overflow: hidden;
}
.alert-title {
  padding: 40rpx 32rpx 4rpx;
  text-align: center;
  font-size: var(--text-base);
  font-weight: 600;
}
.alert-body {
  padding: 16rpx 32rpx 40rpx;
  text-align: center;
  font-size: var(--text-sm);
  color: var(--text-secondary);
  line-height: 1.4;
}
.alert-actions {
  display: flex;
  border-top: 0.5px solid var(--separator);
}
.alert-actions .btn {
  flex: 1;
  height: 88rpx;
  border-radius: 0;
  font-size: var(--text-base);
  background: transparent;
}
.alert-actions .btn:active {
  background: var(--fill-quaternary);
  transform: none;
  opacity: 1;
}
.alert-actions .btn + .btn { border-left: 0.5px solid var(--separator); }
.alert-actions .btn-bold { font-weight: 600; color: var(--blue); }

/* --- 轻提示 --- */
.toast {
  position: fixed;
  top: 50%;
  left: 50%;
  transform: translate(-50%, -50%);
  background: rgba(0, 0, 0, 0.8);
  color: var(--surface);
  padding: 20rpx 40rpx;
  border-radius: var(--radius-sm);
  font-size: var(--text-sm);
  z-index: 2000;
  pointer-events: none;
  letter-spacing: -0.01em;
  animation: toastIn var(--motion-fast) var(--ease);
}

/* --- 开关切换 --- */
.toggle-wrap { display: flex; align-items: center; gap: 20rpx; }
.toggle {
  width: 102rpx;
  height: 62rpx;
  border-radius: 32rpx;
  background: var(--fill-tertiary);
  position: relative;
  transition: background var(--motion-fast) var(--ease);
}
.toggle.on { background: var(--green); }
.toggle::after {
  content: "";
  position: absolute;
  top: 4rpx;
  left: 4rpx;
  width: 54rpx;
  height: 54rpx;
  border-radius: 50%;
  background: var(--surface);
  box-shadow: 0 4rpx 8rpx rgba(0, 0, 0, 0.15);
  transition: transform var(--motion-fast) var(--ease);
}
.toggle.on::after { transform: translateX(40rpx); }

/* --- 图片轮播 --- */
.img-carousel {
  width: 100%;
  height: 560rpx;
  background: var(--dark-surface);
  display: flex;
  align-items: center;
  justify-content: center;
  color: var(--surface);
  font-size: var(--text-sm);
  position: relative;
}
.img-carousel .carousel-dots {
  position: absolute;
  bottom: 24rpx;
  left: 50%;
  transform: translateX(-50%);
  display: flex;
  gap: 12rpx;
}
.carousel-dot {
  width: 14rpx;
  height: 14rpx;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.4);
  transition: background var(--motion-fast) var(--ease);
}
.carousel-dot.active { background: var(--surface); }

/* --- 步骤指示器 --- */
.step-row {
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 40rpx 0;
  gap: 0;
}
.step-dot {
  width: 56rpx;
  height: 56rpx;
  border-radius: 50%;
  background: var(--fill-tertiary);
  color: var(--text-secondary);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 26rpx;
  font-weight: 600;
  flex-shrink: 0;
}
.step-dot.active { background: var(--blue); color: var(--surface); }
.step-dot.done { background: var(--blue); color: var(--surface); }
.step-line {
  width: 96rpx;
  height: 4rpx;
  background: var(--fill-tertiary);
  flex-shrink: 0;
}
.step-line.done { background: var(--blue); }
.step-labels {
  display: flex;
  justify-content: space-between;
  padding: 0 40rpx;
  margin-top: 8rpx;
}
.step-label {
  font-size: var(--text-xs);
  color: var(--text-secondary);
  text-align: center;
  width: 120rpx;
}
.step-label.active { color: var(--blue); font-weight: 500; }

/* --- 个人资料头部 --- */
.profile-header {
  padding: 48rpx var(--margin);
  text-align: center;
}
.profile-header .profile-name {
  font-size: var(--text-xl);
  font-weight: 700;
  margin-top: 16rpx;
}
.profile-header .profile-type {
  font-size: var(--text-sm);
  color: var(--text-secondary);
  margin-top: 4rpx;
}
.rating-summary {
  display: flex;
  justify-content: center;
  gap: 48rpx;
  padding: 0 var(--margin) var(--space-4);
}
.rating-item { text-align: center; }
.rating-item .rating-value { font-size: 64rpx; font-weight: 600; }
.rating-item .rating-label {
  font-size: var(--text-xs);
  color: var(--text-secondary);
  margin-top: 4rpx;
}

/* --- 聊天输入栏 --- */
.chat-input-bar {
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding: 16rpx var(--margin);
  background: rgba(255, 255, 255, 0.94);
  border-top: 0.5px solid var(--separator);
}
.chat-input-bar .chat-input {
  flex: 1;
  height: 72rpx;
  padding: 0 24rpx;
  border: none;
  background: var(--fill-tertiary);
  border-radius: 36rpx;
  font-size: var(--text-base);
}
.chat-input-bar .chat-send {
  color: var(--blue);
  font-size: var(--text-base);
  font-weight: 600;
  flex-shrink: 0;
  padding: 16rpx;
  min-height: 88rpx;
  display: flex;
  align-items: center;
}
.chat-templates {
  padding: 20rpx var(--margin);
  display: flex;
  gap: 16rpx;
  flex-wrap: wrap;
  background: transparent;
}
.chat-tpl-btn {
  font-size: var(--text-sm);
  padding: 12rpx 28rpx;
  background: var(--fill-tertiary);
  color: var(--blue);
  border-radius: 32rpx;
}
.chat-tpl-btn:active {
  background: var(--fill-secondary);
  transform: scale(0.97);
}
.chat-time-divider {
  text-align: center;
  font-size: var(--text-xs);
  color: var(--text-tertiary);
  padding: 16rpx 0;
}

/* --- 带 tabBar 的页面内容 --- */
.page-content.with-tab { padding-bottom: calc(var(--tab-height) + var(--safe-bottom)); }

/* --- 底部弹出层脚部 --- */
.sheet-footer {
  display: flex;
  gap: 16rpx;
  padding: 24rpx 40rpx;
  padding-bottom: calc(12px + var(--safe-bottom));
}

/* --- 字体工具类 --- */
.text-xs { font-size: var(--text-xs); }
.text-sm { font-size: var(--text-sm); }
.font-semibold { font-weight: 600; }

/* --- 外边距工具类 --- */
.mt-4 { margin-top: 8rpx; }
.mt-8 { margin-top: 16rpx; }
.mt-16 { margin-top: 32rpx; }
.mb-8 { margin-bottom: 16rpx; }
.mb-16 { margin-bottom: 32rpx; }
