{
  "name": "miniprogram",
  "version": "1.0.0",
  "main": "app.js",
  "scripts": {
    "test": "jest --coverage",
    "test:watch": "jest --watch"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "description": "",
  "dependencies": {
    "sharp": "^0.35.3"
  },
  "devDependencies": {
    "jest": "^29.7.0"
  },
  "jest": {
    "testEnvironment": "node",
    "testMatch": [
      "**/__tests__/**/*.test.js"
    ],
    "collectCoverageFrom": [
      "utils/**/*.js"
    ],
    "coverageThreshold": {
      "global": {
        "lines": 80,
        "branches": 65,
        "functions": 75,
        "statements": 80
      }
    }
  }
}
