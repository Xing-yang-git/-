.img-upload-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 16rpx;
}

.img-upload-item {
  aspect-ratio: 1;
  border-radius: 16rpx;
  background: var(--fill-tertiary);
  display: flex;
  align-items: center;
  justify-content: center;
  position: relative;
  overflow: hidden;
}

.img-upload-img {
  width: 100%;
  height: 100%;
}

.img-upload-add {
  font-size: 64rpx;
  color: var(--text-tertiary);
}

.img-upload-add-icon {
  font-size: 64rpx;
  color: var(--text-tertiary);
  font-weight: 300;
  line-height: 1;
}

.img-delete {
  position: absolute;
  top: 8rpx;
  right: 8rpx;
  width: 44rpx;
  height: 44rpx;
  border-radius: 50%;
  background: rgba(0, 0, 0, 0.65);
  color: var(--surface);
  font-size: 26rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}
