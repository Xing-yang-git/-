.img-upload-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 8px;
}

.img-upload-item {
  aspect-ratio: 1;
  border-radius: 8px;
  background: var(--fill-tertiary);
  display: flex;
  align-items: center;
  justify-content: center;
  position: relative;
  overflow: hidden;
}

.img-upload-img {
  width: 100%;
  height: 100%;
}

.img-upload-add {
  font-size: 32px;
  color: var(--text-tertiary);
}

.img-upload-add-icon {
  font-size: 32px;
  color: var(--text-tertiary);
  font-weight: 300;
  line-height: 1;
}

.img-delete {
  position: absolute;
  top: 4px;
  right: 4px;
  width: 22px;
  height: 22px;
  border-radius: 50%;
  background: rgba(0, 0, 0, 0.65);
  color: #FFFFFF;
  font-size: 13px;
  display: flex;
  align-items: center;
  justify-content: center;
}
