/* ─── 共享聊天输入栏（对齐原型 chat.html 输入区 + ios-ui.css） ─── */
/* 设计稿 375px → 小程序 750rpx（1px = 2rpx） */

/* 输入栏（fixed 定位，bottom 跟随键盘即时上移） */
.chat-input-bar {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  padding: 16rpx 32rpx;
  padding-bottom: calc(16rpx + env(safe-area-inset-bottom));
  background: rgba(255, 255, 255, 0.94);
  border-top: 0.5px solid var(--separator);
  z-index: 10;
  /* 快速过渡动画：键盘弹起/收起时输入栏平滑跟随 */
  transition: bottom 0.15s ease-out;
}

/* 输入行 — mic + 输入区 + plus + send */
.chat-input-row {
  display: flex;
  align-items: center; /* 常规高度（未聚焦）图标垂直居中 */
  width: 100%;
}

/* 聚焦（键盘顶起）或多行增高（长文本）：左右图标贴底部，不随输入框增高垂直居中 */
.chat-input-row-focused,
.chat-input-row-multiline {
  align-items: flex-end;
}

/* 输入框外套 — 文字模式下 textarea + send 的容器 */
.chat-input-wrapper {
  display: flex;
  align-items: center; /* 常规高度（未聚焦）发送图标垂直居中 */
  flex: 1;
  min-width: 0;
  background: rgba(120, 120, 128, 0.12);
  border-radius: 26rpx;
  padding: 0 8rpx 0 24rpx;
  min-height: 108rpx; /* 未聚焦高度：原 72rpx 加高一半（用户反馈按压区太小易脱落） */
  margin: 0 8rpx;
}

/* 聚焦态：输入框高度翻一倍（原 72rpx → 144rpx），扩大打字/按压区域；发送图标贴底 */
.chat-input-wrapper-focused {
  min-height: 144rpx;
  align-items: flex-end;
}

/* 多行增高态（失焦保留长文本仍贴底，不随内容增高垂直居中） */
.chat-input-wrapper-multiline {
  align-items: flex-end;
}

.chat-input {
  flex: 1;
  align-self: flex-start; /* 文字/提示词顶部对齐：placeholder 垂直居上，输入文字从输入区顶部增长（发送图标仍贴底） */
  height: 100%; /* 与 wrapper 等高，填满输入区（auto-height 模式下高度由内容决定） */
  max-height: 320rpx; /* 最大固定高度（约 3 行）：超过后内部滚动，不再无限增高撑爆聊天区 */
  overflow-y: auto; /* 内容超过 max-height 时允许输入区内滚动 */
  border: none;
  background: transparent !important;
  font-size: 38rpx; /* 17px → 38rpx */
  color: var(--text, var(--text));
  line-height: 1.2;
  padding-top: 12rpx; /* 上下留白，文字与输入区边框保持间距 */
  padding-bottom: 12rpx;
  box-sizing: border-box;
}

/* 发送图标 — flex 子项，padding 扩大点击热区（参照搜索页 .search-clear） */
.chat-send-icon {
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 16rpx;
  flex-shrink: 0;
}

.chat-send-icon:active {
  transform: scale(0.85);
  opacity: 0.6;
}

.send-icon-plane {
  width: 40rpx;
  height: 40rpx;
}

/* 终止图标：纯红色圆角正方形、内部无内容（对齐录音停止符惯例） */
.chat-stop-inner {
  width: 32rpx;
  height: 32rpx;
  background: var(--red);
  border-radius: 6rpx;
  box-sizing: border-box;
}

/* 语音模式发送中终止按钮（右侧，与 + 按钮同位等大） */
.chat-stop-btn {
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 16rpx;
  flex-shrink: 0;
}

/* 发送中禁用态：麦克风 / 按住说话弱化 */
.chat-btn-disabled {
  opacity: 0.4;
}

.chat-hold-to-talk-disabled {
  opacity: 0.5;
}

.chat-hold-to-talk-disabled:active {
  background: rgba(120, 120, 128, 0.12); /* 与默认一致，取消按压变深反馈 */
}

/* 输入栏按钮（mic / plus / keyboard） */
.chat-mic-btn,
.chat-plus-btn,
.chat-keyboard-toggle {
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 16rpx;
  flex-shrink: 0;
}
.chat-mic-btn image,
.chat-plus-btn image,
.chat-keyboard-toggle image {
  width: 44rpx;
  height: 44rpx;
}
.chat-mic-btn:active,
.chat-plus-btn:active,
.chat-keyboard-toggle:active {
  opacity: 0.6;
}

/* 按住说话按钮（与输入框等高，扩大按压有效区域） */
.chat-hold-to-talk {
  flex: 1;
  height: 108rpx;
  border-radius: 26rpx;
  background: rgba(120, 120, 128, 0.12);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 32rpx;
  color: var(--text, var(--text));
  margin: 0 8rpx;
  user-select: none;
  -webkit-user-select: none;
}
.chat-hold-to-talk:active {
  background: rgba(120, 120, 128, 0.24);
}
