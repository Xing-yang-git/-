.nav-bar {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  z-index: 100;
  background: rgba(255, 255, 255, 0.94);
}

.nav-bar-inner {
  display: flex;
  align-items: center;
  justify-content: center;
  height: 88rpx;
  padding: 0 32rpx;
  position: relative;
}

.nav-title {
  font-size: 34rpx;
  font-weight: 600;
  color: var(--text);
  letter-spacing: -0.01em;
  max-width: 60%;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.nav-left {
  position: absolute;
  left: 16rpx;
  min-width: 120rpx;
}

.nav-back {
  display: flex;
  align-items: center;
  gap: 4rpx;
  padding: 16rpx 16rpx 16rpx 0;
  min-height: 88rpx;
}

.nav-back-icon {
  font-size: 72rpx;
  line-height: 1;
  font-weight: 600;
  color: var(--text-secondary);
}

.nav-right {
  position: absolute;
  right: 32rpx;
  min-width: 120rpx;
  display: flex;
  justify-content: flex-end;
}

.nav-action {
  font-size: 34rpx;
  color: var(--blue);
  font-weight: 500;
  padding: 16rpx;
  min-height: 88rpx;
  display: flex;
  align-items: center;
}
